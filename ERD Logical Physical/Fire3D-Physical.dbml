// Fire3D physical model, generated from the production PostgreSQL schema (Supabase Singapore, checked 2026-10-27, 136 migrations; revision_processing_logs and its two enums already left out, dropped by the same-day cleanup).
// Paste into https://dbdiagram.io . Tables are grouped like 2-Physical.md (B1-B12).

Project fire3d {
  database_type: 'PostgreSQL'
}

Enum audit_action_enum {
  "Upload"
  "ConfirmForTraining"
  "Reject"
  "Publish"
  "Revoke"
  "Sync"
  "Login"
  "Logout"
  "Download"
  "Delete"
  "Create"
  "Update"
  "Rollback"
  "Grant"
  "Resume"
  "Payment"
  "Support"
}

Enum feedback_status_enum {
  "Submitted"
  "Reviewed"
  "Closed"
}

Enum file_type_enum {
  "IFC"
}

Enum payment_request_status_enum {
  "Pending"
  "Paid"
  "Expired"
  "Cancelled"
  "Failed"
}

Enum payment_transaction_status_enum {
  "Received"
  "Verified"
  "Rejected"
  "Applied"
}

Enum quarantine_status_enum {
  "Pending"
  "Accepted"
  "Rejected"
}

Enum quotation_status_enum {
  "Draft"
  "Issued"
  "Accepted"
  "Expired"
  "Cancelled"
}

Enum release_status_enum {
  "Built"
  "Published"
  "Superseded"
  "Revoked"
}

Enum review_action_enum {
  "ConfirmForTraining"
  "Rejected"
}

Enum revision_status_enum {
  "Draft"
  "Uploaded"
  "Processing"
  "NeedsFix"
  "ReadyForScenario"
  "ConfirmedForTraining"
  "Rejected"
  "Failed"
  "Superseded"
}

Enum session_mode_enum {
  "Learn"
  "Guided"
  "Assessment"
}

Enum session_status_enum {
  "Created"
  "Launching"
  "Running"
  "Completed"
  "CompletedWithSupersededRelease"
  "ScenarioUnsurvivable"
  "Aborted"
  "Abandoned"
  "Crashed"
}

Enum support_priority_enum {
  "Low"
  "Normal"
  "High"
  "Urgent"
}

Enum support_ticket_status_enum {
  "Open"
  "InProgress"
  "Resolved"
  "Closed"
}

Enum training_status_enum {
  "Draft"
  "Active"
  "Closed"
  "Archived"
}

Enum user_role_enum {
  "PlatformAdmin"
  "OrganizationUser"
  "Trainee"
}

Table ai_command_receipts {
  "actor_user_id" uuid [not null]
  "operation" text [not null]
  "idempotency_key" varchar(128) [not null]
  "input_hash" varchar(64) [not null]
  "result" jsonb [not null]
  "created_at" timestamptz [not null]

  indexes {
    (actor_user_id, operation, idempotency_key) [pk]
  }
}

Table ai_operation_policies {
  "id" uuid [pk]
  "operation" text [not null, note: '''CHECK ((operation = ANY (ARRAY['ScenarioDraft'::text, 'Answer'::text, 'TraineeAnswer'::text])))''']
  "quota_unit" text [not null, note: '''CHECK ((quota_unit ~ '^[a-z][a-z0-9_-]{0,49}$'::text))''']
  "reserve_units" integer [not null, note: '''CHECK (((reserve_units >= 1) AND (reserve_units <= 100000000)))''']
  "max_input_chars" integer [not null, note: '''CHECK (((max_input_chars >= 1) AND (max_input_chars <= 20000)))''']
  "max_sources" integer [not null, note: '''CHECK (((max_sources >= 1) AND (max_sources <= 100)))''']
  "effective_from" timestamptz [not null]
  "effective_until" timestamptz
  "created_by" uuid [not null]
  "created_at" timestamptz [not null]
  "daily_units" integer

  Note: '''CHECK (((effective_until IS NULL) OR (effective_until > effective_from)))
CHECK ((((operation = 'TraineeAnswer'::text) = (daily_units IS NOT NULL)) AND ((daily_units IS NULL) OR ((daily_units >= 1) AND (daily_units <= 100000000) AND (daily_units >= reserve_units)))))
ai_operation_policies_operation_tstzrange_excl: EXCLUDE USING gist (operation WITH =, tstzrange(effective_from, effective_until, '[)'::text) WITH &&)'''
}

Table ai_requests {
  "id" uuid [pk]
  "organization_id" uuid
  "actor_user_id" uuid [not null]
  "operation" text [not null, note: '''CHECK ((operation = ANY (ARRAY['ScenarioDraft'::text, 'Answer'::text, 'TraineeAnswer'::text])))''']
  "policy_id" uuid [not null]
  "quota_unit" text [not null]
  "reserved_units" integer [not null, note: '''CHECK ((reserved_units > 0))''']
  "consumed_units" integer
  "status" text [not null, note: '''CHECK ((status = ANY (ARRAY['Accepted'::text, 'Processing'::text, 'Succeeded'::text, 'Failed'::text, 'NeedsReconcile'::text, 'Rejected'::text])))''']
  "input" jsonb [not null, note: '''CHECK ((jsonb_typeof(input) = 'object'::text))''']
  "input_hash" varchar(64) [not null]
  "sources" jsonb [not null, note: '''CHECK ((jsonb_typeof(sources) = 'array'::text))''']
  "result" jsonb
  "provider_result" jsonb
  "failure_code" varchar(80)
  "attempts" integer [not null, default: 0, note: '''CHECK ((attempts >= 0))''']
  "lease_token" uuid
  "lease_until" timestamptz
  "next_attempt_at" timestamptz [not null]
  "reconcile_requested_at" timestamptz
  "reconcile_requested_by" uuid
  "created_at" timestamptz [not null]
  "updated_at" timestamptz [not null]
  "completed_at" timestamptz
  "revision" bigint [not null, default: 1, note: '''CHECK ((revision > 0))''']
  "audience" text [not null, default: 'organization']
  "result_type" text [note: '''CHECK (((result_type IS NULL) OR (result_type = ANY (ARRAY['KnowledgeAnswer'::text, 'ScenarioDraft'::text, 'InsufficientEvidence'::text, 'RejectedBySafetyGate'::text]))))''']
  "context" jsonb
  "bim" jsonb
  "model_version" text
  "technical_usage" jsonb

  indexes {
    (status, next_attempt_at, created_at) [name: 'ai_requests_dispatch']
  }

  Note: '''CHECK (((audience = ANY (ARRAY['organization'::text, 'trainee'::text])) AND ((audience = 'organization'::text) = (organization_id IS NOT NULL)) AND ((audience = 'trainee'::text) = (operation = 'TraineeAnswer'::text))))
CHECK (((consumed_units >= 0) AND (consumed_units <= reserved_units)))
CHECK (((lease_token IS NULL) = (lease_until IS NULL)))
CHECK (((status <> 'Processing'::text) OR (lease_token IS NOT NULL)))
CHECK (((status = 'Succeeded'::text) = ((consumed_units IS NOT NULL) AND (result IS NOT NULL) AND (result_type IS NOT NULL))))
CHECK (((status = ANY (ARRAY['Succeeded'::text, 'Failed'::text, 'Rejected'::text])) = (completed_at IS NOT NULL)))
CREATE INDEX ai_requests_organization ON ai_requests USING btree (organization_id, created_at DESC, id)
CREATE INDEX ai_requests_trainee ON ai_requests USING btree (actor_user_id, created_at DESC, id) WHERE (audience = 'trainee'::text)'''
}

Table analytics_exports {
  "id" uuid [pk]
  "actor_id" uuid [not null]
  "organization_id" uuid
  "report" text [not null]
  "filters" jsonb [not null, note: '''CHECK ((jsonb_typeof(filters) = 'object'::text))''']
  "row_count" integer [not null, note: '''CHECK ((row_count >= 0))''']
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    (actor_id, created_at) [name: 'analytics_exports_actor_day']
  }
}

Table annotation_sets {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "revision_id" uuid [not null]
  "version_number" integer [not null, note: '''CHECK ((version_number > 0))''']
  "data" jsonb [not null, note: '''CHECK ((jsonb_typeof(data) = 'object'::text))''']
  "provenance" text [not null, default: 'manual', note: '''CHECK ((provenance = ANY (ARRAY['manual'::text, 'pipeline'::text])))''']
  "created_by" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    (id, revision_id) [unique]
    (revision_id, version_number) [unique]
  }
}

Table application_command_receipts {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "actor_user_id" uuid [not null]
  "organization_id" uuid
  "operation_name" varchar(100) [not null]
  "idempotency_key" varchar(255) [not null, note: '''CHECK ((NULLIF(btrim((idempotency_key)::text), ''::text) IS NOT NULL))''']
  "input_hash" varchar(128) [not null, note: '''CHECK (((input_hash)::text ~ '^[0-9a-fA-F]{64,128}$'::text))''']
  "result_status" varchar(30) [not null, note: '''CHECK (((result_status)::text = ANY (ARRAY[('Succeeded'::character varying)::text, ('Rejected'::character varying)::text])))''']
  "result_payload" jsonb [not null, default: `'{}'::jsonb`]
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    (actor_user_id, operation_name, idempotency_key) [unique]
  }

  Note: '''CREATE INDEX idx_command_receipts_operation ON application_command_receipts USING btree (operation_name, created_at DESC)'''
}

Table audit_logs {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "user_id" uuid
  "organization_id" uuid
  "actor_type" text [not null, default: 'User', note: '''CHECK ((actor_type = ANY (ARRAY['User'::text, 'Worker'::text, 'System'::text])))''']
  "action" audit_action_enum [not null]
  "target_entity" text [not null]
  "target_id" uuid
  "correlation_id" uuid [not null, default: `extensions.gen_random_uuid()`]
  "old_values" jsonb
  "new_values" jsonb
  "ip_address" inet
  "user_agent" text
  "created_at" timestamptz [not null, default: `now()`]

  Note: '''CREATE INDEX audit_logs_target_history ON audit_logs USING btree (target_entity, target_id, created_at DESC, id DESC)
CREATE INDEX audit_org_history ON audit_logs USING btree (organization_id, created_at DESC)'''
}

Table auth_google_onboarding_sessions {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "firebase_uid" varchar(128) [not null, note: '''CHECK ((length((firebase_uid)::text) > 0))''']
  "email" varchar(255) [not null, note: '''CHECK (((email)::text = lower(btrim((email)::text))))''']
  "onboarding_token_hash" varchar(128) [not null, unique, note: '''CHECK (((onboarding_token_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "requested_role" user_role_enum [note: '''CHECK (((requested_role IS NULL) OR (requested_role = ANY (ARRAY['Trainee'::user_role_enum, 'OrganizationUser'::user_role_enum]))))''']
  "organization_draft" jsonb [not null, default: `'{}'::jsonb`]
  "expires_at" timestamptz [not null]
  "completed_at" timestamptz
  "completed_user_id" uuid
  "completed_input_hash" varchar(128)
  "created_at" timestamptz [not null, default: `now()`]
  "display_name" varchar(200)

  Note: '''CHECK (((completed_at IS NULL) OR ((completed_at >= created_at) AND (completed_user_id IS NOT NULL) AND ((completed_input_hash)::text ~ '^[0-9a-f]{64}$'::text) AND (completed_input_hash IS NOT NULL))))
CHECK ((expires_at > created_at))
CHECK (((completed_at IS NOT NULL) OR ((completed_user_id IS NULL) AND (completed_input_hash IS NULL))))
CREATE INDEX idx_google_onboarding_active ON auth_google_onboarding_sessions USING btree (firebase_uid, expires_at) WHERE (completed_at IS NULL)
CREATE INDEX idx_google_onboarding_completed_user ON auth_google_onboarding_sessions USING btree (completed_user_id) WHERE (completed_user_id IS NOT NULL)'''
}

Table auth_refresh_tokens {
  "id" uuid [pk]
  "user_id" uuid [not null]
  "family_id" uuid [not null]
  "token_hash" varchar(64) [not null, unique, note: '''CHECK (((token_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "created_at" timestamptz [not null]
  "expires_at" timestamptz [not null]
  "consumed_at" timestamptz
  "revoked_at" timestamptz

  indexes {
    (expires_at) [name: 'auth_refresh_tokens_expiry']
    (user_id, family_id) [name: 'auth_refresh_tokens_user_family']
  }

  Note: '''CHECK ((expires_at > created_at))
CHECK ((consumed_at >= created_at))
CHECK ((revoked_at >= created_at))
CREATE UNIQUE INDEX auth_refresh_tokens_one_active ON auth_refresh_tokens USING btree (family_id) WHERE ((consumed_at IS NULL) AND (revoked_at IS NULL))'''
}

Table authoring_command_receipts {
  "actor_id" uuid [not null]
  "operation" text [not null]
  "idempotency_key" varchar(128) [not null]
  "input_hash" varchar(64) [not null, note: '''CHECK (((input_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
