  "draft_number" integer [not null]
  "state" jsonb [not null]
  "source" text [not null]
  "last_ai_request_id" uuid
  "created_by" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    (building_id) [name: 'IX_scenario_drafts_building_id']
    (created_by) [name: 'IX_scenario_drafts_created_by']
    (organization_id) [name: 'IX_scenario_drafts_organization_id']
    (revision_id) [name: 'IX_scenario_drafts_revision_id']
    (scenario_id) [name: 'IX_scenario_drafts_scenario_id']
    (scenario_id, draft_number) [unique, name: 'scenario_draft_number_key']
  }
}

Table scenario_versions {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "scenario_id" uuid [not null]
  "revision_id" uuid [not null]
  "building_id" uuid [not null]
  "organization_id" uuid [not null]
  "version_number" integer [not null, note: '''CHECK ((version_number > 0))''']
  "name" text [not null, note: '''CHECK ((btrim(name) <> ''::text))''']
  "schema_version" text [not null, default: '1.0']
  "algorithm_version" text [not null, note: '''CHECK ((btrim(algorithm_version) <> ''::text))''']
  "random_seed" bigint [not null]
  "time_limit_seconds" integer [not null]
  "spawn_config" jsonb [not null]
  "goal_config" jsonb [not null]
  "fire_source_config" jsonb [not null, default: `'{}'::jsonb`]
  "npc_config" jsonb [not null, default: `'{}'::jsonb`]
  "blocked_elements" jsonb [not null, default: `'[]'::jsonb`, note: '''CHECK ((jsonb_typeof(blocked_elements) = 'array'::text))''']
  "routing_config" jsonb [not null, note: '''CHECK ((jsonb_typeof(routing_config) = 'object'::text))''']
  "scoring_config" jsonb [not null, note: '''CHECK ((jsonb_typeof(scoring_config) = 'object'::text))''']
  "mode_policy" jsonb [not null]
  "safety_thresholds" jsonb [not null, default: `'{}'::jsonb`, note: '''CHECK ((jsonb_typeof(safety_thresholds) = 'object'::text))''']
  "replan_interval_seconds" integer [not null, default: 5]
  "scenario_hash" varchar(64) [not null, note: '''CHECK (((scenario_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "created_by" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "state_snapshot" jsonb
  "learning_objectives" jsonb
  "learner_instructions" text
  "rubric" jsonb

  indexes {
    (id, revision_id, organization_id) [unique]
    (scenario_id, version_number) [unique]
  }
}

Table scenarios {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "building_id" uuid [not null]
  "organization_id" uuid [not null]
  "name" text [not null, note: '''CHECK ((btrim(name) <> ''::text))''']
  "created_by" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    (id, building_id, organization_id) [unique]
  }
}

Table service_entitlements {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "organization_id" uuid [not null]
  "building_id" uuid [not null]
  "service_package_id" uuid [not null]
  "quotation_id" uuid
  "quotation_item_id" uuid
  "payment_transaction_id" uuid
  "provisioning_key" varchar(255) [not null, unique]
  "status" varchar(30) [not null, default: 'Active', note: '''CHECK (((status)::text = ANY (ARRAY[('Trial'::character varying)::text, ('Active'::character varying)::text, ('Expired'::character varying)::text, ('Suspended'::character varying)::text, ('Cancelled'::character varying)::text])))''']
  "starts_at" timestamptz [not null]
  "ends_at" timestamptz [not null]
  "price_snapshot" jsonb [not null, default: `'{}'::jsonb`]
  "terms_snapshot" jsonb [not null, default: `'{}'::jsonb`]
  "playtest_units_granted" integer [not null, default: 0]
  "playtest_units_used" integer [not null, default: 0]
  "created_by" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "commercial_version" integer [not null, default: 1]
  "learner_limit" integer

  indexes {
    (building_id, starts_at) [unique]
    (quotation_item_id, payment_transaction_id) [unique]
  }

  Note: '''CHECK ((((status)::text <> 'Active'::text) OR ((quotation_id IS NOT NULL) AND (quotation_item_id IS NOT NULL) AND (payment_transaction_id IS NOT NULL))))
CHECK (((playtest_units_granted >= 0) AND (playtest_units_used >= 0) AND (playtest_units_used <= playtest_units_granted)))
CHECK ((ends_at > starts_at))
CHECK (((commercial_version = ANY (ARRAY[1, 7])) AND ((commercial_version <> 7) OR ((learner_limit IS NOT NULL) AND (learner_limit > 0)))))'''
}

Table service_package_discount_rules {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "service_package_id" uuid
  "code" varchar(80) [not null, unique]
  "discount_kind" varchar(20) [not null, note: '''CHECK (((discount_kind)::text = ANY (ARRAY[('Percent'::character varying)::text, ('Fixed'::character varying)::text])))''']
  "discount_value" numeric(14,2) [not null, note: '''CHECK ((discount_value >= (0)::numeric))''']
  "discount_currency" varchar(3)
  "minimum_buildings" integer [not null, default: 1, note: '''CHECK ((minimum_buildings > 0))''']
  "minimum_duration_months" integer [note: '''CHECK (((minimum_duration_months IS NULL) OR (minimum_duration_months > 0)))''']
  "valid_from" timestamptz [not null]
  "valid_until" timestamptz
  "is_active" boolean [not null, default: true]
  "created_by" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "revision" bigint [not null, default: 1]

  Note: '''CHECK (((((discount_kind)::text = 'Fixed'::text) AND (discount_currency IS NOT NULL) AND ((discount_currency)::text ~ '^[A-Z]{3}$'::text)) OR (((discount_kind)::text = 'Percent'::text) AND (discount_currency IS NULL))))
CHECK (((valid_until IS NULL) OR (valid_until > valid_from)))
CHECK ((((discount_kind)::text <> 'Percent'::text) OR (discount_value <= (100)::numeric)))'''
}

Table service_packages {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "code" varchar(50) [not null, unique]
  "name" varchar(255) [not null]
  "description" text
  "unit_price" numeric(14,2) [not null, note: '''CHECK ((unit_price >= (0)::numeric))''']
  "currency" varchar(3) [not null, default: 'VND', note: '''CHECK (((currency)::text ~ '^[A-Z]{3}$'::text))''']
  "duration_months" integer [note: '''CHECK (((duration_months IS NULL) OR (duration_months > 0)))''']
  "features" jsonb [not null, default: `'{}'::jsonb`]
  "is_active" boolean [not null, default: true]
  "created_by" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "revision" bigint [not null, default: 1]
  "commercial_version" integer [not null, default: 1]
  "learner_limit" integer
  "ai_quota_units" integer
  "ai_policy_version_id" uuid

  indexes {
    (created_by) [name: 'idx_service_packages_created_by']
  }

  Note: '''CHECK (((commercial_version = ANY (ARRAY[1, 7])) AND ((commercial_version <> 7) OR ((duration_months = ANY (ARRAY[6, 12])) AND (learner_limit IS NOT NULL) AND (learner_limit > 0) AND (ai_quota_units IS NOT NULL) AND (ai_quota_units >= 0) AND ((ai_quota_units = 0) OR (ai_policy_version_id IS NOT NULL))))))
CREATE INDEX idx_service_packages_active ON service_packages USING btree (code) WHERE is_active'''
}

Table session_events {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "session_id" uuid [not null]
  "sequence_number" bigint [not null, note: '''CHECK ((sequence_number > 0))''']
  "client_event_id" uuid [not null]
  "schema_version" text [not null, default: '1.0']
  "event_type" text [not null, note: '''CHECK ((btrim(event_type) <> ''::text))''']
  "event_data" jsonb [not null, default: `'{}'::jsonb`, note: '''CHECK ((jsonb_typeof(event_data) = 'object'::text))''']
  "elapsed_ms" bigint [not null, note: '''CHECK ((elapsed_ms >= 0))''']
  "recorded_at" timestamptz [not null]
  "received_at" timestamptz [not null, default: `now()`]
  "payload_hash" varchar(64) [note: '''CHECK (((payload_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "rejection_code" varchar(64) [note: '''CHECK (((rejection_code)::text = ANY (ARRAY[('EVENT_TYPE_UNSUPPORTED'::character varying)::text, ('EVENT_PAYLOAD_INVALID'::character varying)::text])))''']

  indexes {
    (session_id, client_event_id) [unique]
    (session_id, sequence_number) [unique]
  }
}

Table session_results {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "session_id" uuid [not null, unique]
  "completion_key" uuid [not null]
  "last_event_sequence" bigint [not null, note: '''CHECK ((last_event_sequence >= 0))''']
  "submission_payload" jsonb [not null, note: '''CHECK ((jsonb_typeof(submission_payload) = 'object'::text))''']
  "result_schema_version" text [not null, default: '1.0']
  "rubric_version" text [not null, note: '''CHECK ((btrim(rubric_version) <> ''::text))''']
  "score" numeric(5,2) [note: '''CHECK (((score >= (0)::numeric) AND (score <= (100)::numeric)))''']
  "time_taken_seconds" integer [note: '''CHECK ((time_taken_seconds >= 0))''']
  "wrong_exits" integer [default: 0, note: '''CHECK ((wrong_exits >= 0))''']
  "hazard_exposure_score" numeric(12,2) [default: 0, note: '''CHECK ((hazard_exposure_score >= (0)::numeric))''']
  "total_distance_meters" numeric(12,2) [default: 0, note: '''CHECK ((total_distance_meters >= (0)::numeric))''']
  "reached_exit" boolean
  "exit_point_id" text
  "path_traveled" jsonb [default: `'[]'::jsonb`, note: '''CHECK ((jsonb_typeof(path_traveled) = 'array'::text))''']
  "client_started_at" timestamptz
  "client_ended_at" timestamptz
  "synced_at" timestamptz [not null, default: `now()`]
  "created_at" timestamptz [not null, default: `now()`]
  "contract_version" integer [not null, default: 1]
  "mode" text
  "outcome" text [note: '''CHECK ((outcome = ANY (ARRAY['Passed'::text, 'NotPassed'::text, 'Incomplete'::text, 'NotAssessed'::text])))''']
  "outcome_reason" text
  "rubric_hash" varchar(64)
  "criterion_results" jsonb
  "metrics" jsonb

  indexes {
    (session_id, created_at) [name: 'session_results_session_created']
  }

  Note: '''CHECK (((client_started_at IS NULL) OR (client_ended_at IS NULL) OR (client_ended_at >= client_started_at)))
CHECK (((contract_version = 1) OR ((contract_version = 7) AND (outcome IS NOT NULL) AND (metrics IS NOT NULL) AND (mode IS NOT NULL))))'''
}

Table sessions {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "training_id" uuid [not null]
  "release_id" uuid [not null]
  "scenario_version_id" uuid [not null]
  "organization_id" uuid [not null]
  "trainee_user_id" uuid [not null]
  "device_id" uuid
  "start_key" uuid [not null]
  "app_version" text
  "unity_version" text
  "protocol_version" text [not null, default: '1.0']
  "scenario_hash" varchar(64) [not null, note: '''CHECK (((scenario_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "release_hash" varchar(64) [not null, note: '''CHECK (((release_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "mode" session_mode_enum [not null]
  "status" session_status_enum [not null, default: `'Created'::session_status_enum`]
  "started_at" timestamptz [not null, default: `now()`]
  "launched_at" timestamptz
  "ended_at" timestamptz
  "terminal_reason" text
  "content_status_at_completion" release_status_enum
  "contract_version" integer [not null, default: 1]
  "building_id" uuid
  "entitlement_id" uuid
  "seat_id" uuid
  "rubric_hash" varchar(64)
  "package" jsonb
  "runtime_version" text
  "launch_family" uuid
  "grant_generation" integer
  "grant_issued_at" timestamptz
  "grant_expires_at" timestamptz
  "last_heartbeat_at" timestamptz
  "continuation_id" uuid
  "continuation_expires_at" timestamptz
  "completion_key" varchar(128)
  "completion_hash" varchar(64)
  "completion_last_sequence" bigint
  "completion_end_reason" text
  "completion_requested_at" timestamptz

  indexes {
    (trainee_user_id, start_key) [unique]
    (release_id) [name: 'sessions_release']
    (training_id, trainee_user_id, mode) [name: 'sessions_training_attempts']
  }

  Note: '''CHECK (((launched_at IS NULL) OR (launched_at >= started_at)))
CHECK (((ended_at IS NULL) OR (ended_at >= started_at)))
CHECK (((status <> ALL (ARRAY['Running'::session_status_enum, 'Completed'::session_status_enum, 'CompletedWithSupersededRelease'::session_status_enum, 'ScenarioUnsurvivable'::session_status_enum])) OR (launched_at IS NOT NULL)))
CREATE INDEX sessions_org_history ON sessions USING btree (organization_id, started_at DESC)
CREATE INDEX sessions_personal_history ON sessions USING btree (trainee_user_id, started_at DESC)
CREATE INDEX sessions_v7_building_started ON sessions USING btree (building_id, started_at) WHERE (contract_version = 7)
CREATE INDEX sessions_v7_running_heartbeat ON sessions USING btree (last_heartbeat_at) WHERE ((contract_version = 7) AND (status = 'Running'::session_status_enum))
CREATE INDEX sessions_v7_trainee_started ON sessions USING btree (trainee_user_id, started_at DESC, id DESC) WHERE (contract_version = 7)'''
}

Table source_documents {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "revision_id" uuid [not null, unique]
  "uploaded_by" uuid [not null]
  "original_filename" text [not null]
  "file_type" file_type_enum [not null, default: `'IFC'::file_type_enum`]
  "file_size_bytes" bigint [not null, note: '''CHECK ((file_size_bytes > 0))''']
  "storage_url" text [not null, note: '''CHECK ((btrim(storage_url) <> ''::text))''']
  "mime_type" text [not null]
  "sha256_hash" varchar(64) [not null, note: '''CHECK (((sha256_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "quarantine_status" quarantine_status_enum [not null, default: `'Pending'::quarantine_status_enum`]
  "quarantine_note" text
  "usage_rights" text [not null, note: '''CHECK ((btrim(usage_rights) <> ''::text))''']
  "source_tool" text
  "created_at" timestamptz [not null, default: `now()`]
  "upload_verified_at" timestamptz
  "source_etag" text

  indexes {
    (id, revision_id) [unique]
  }
}

Table support_command_receipts {
  "actor_id" uuid [not null]
  "operation" text [not null]
  "idempotency_key" varchar(128) [not null]
  "input_hash" varchar(64) [not null, note: '''CHECK (((input_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "result" jsonb [not null]
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    (actor_id, operation, idempotency_key) [pk]
  }
}

Table support_ticket_messages {
  "id" uuid [pk]
  "ticket_id" uuid [not null]
  "author_id" uuid [not null]
  "message" text [not null, note: '''CHECK (((length(message) >= 1) AND (length(message) <= 10000)))''']
  "created_at" timestamptz [not null]

  indexes {
    (ticket_id, created_at) [name: 'ix_support_ticket_messages_ticket_created']
    (ticket_id, created_at, id) [name: 'support_messages_page']
  }
}

Table support_tickets {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "ticket_number" varchar(50) [not null, unique]
  "created_by" uuid [not null]
  "organization_id" uuid
  "session_id" uuid
  "feedback_id" uuid
  "assigned_to" uuid
  "subject" varchar(255) [not null, note: '''CHECK ((NULLIF(btrim((subject)::text), ''::text) IS NOT NULL))''']
  "description" text [not null, note: '''CHECK ((NULLIF(btrim(description), ''::text) IS NOT NULL))''']
  "priority" support_priority_enum [not null, default: `'Normal'::support_priority_enum`]
  "status" support_ticket_status_enum [not null, default: `'Open'::support_ticket_status_enum`]
  "resolved_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "revision" bigint [not null, default: 1, note: '''CHECK ((revision > 0))''']

  indexes {
    (assigned_to) [name: 'idx_support_tickets_assigned_to']
    (created_by) [name: 'idx_support_tickets_created_by']
    (feedback_id) [name: 'idx_support_tickets_feedback']
    (organization_id) [name: 'idx_support_tickets_organization']
    (status, priority, created_at) [name: 'idx_support_tickets_queue']
    (session_id) [name: 'idx_support_tickets_session']
  }

  Note: '''CHECK (((status <> 'Resolved'::support_ticket_status_enum) OR (resolved_at IS NOT NULL)))
CHECK (((length(btrim((subject)::text)) >= 1) AND (length(btrim((subject)::text)) <= 255) AND ((length(btrim(description)) >= 1) AND (length(btrim(description)) <= 10000))))
CREATE INDEX support_tickets_owner_page ON support_tickets USING btree (created_by, created_at DESC, id)'''
}

Table training_session_preparations {
  "id" uuid [pk]
  "trainee_user_id" uuid [not null]
  "organization_id" uuid [not null]
  "building_id" uuid [not null]
  "training_id" uuid [not null]
  "release_id" uuid [not null]
  "scenario_version_id" uuid [not null]
  "mode" text [not null, note: '''CHECK ((mode = ANY (ARRAY['Learn'::text, 'Guided'::text, 'Assessment'::text])))''']
  "scenario_hash" varchar(64) [not null]
  "rubric_hash" varchar(64)
  "package" jsonb [not null]
  "runtime_version" text [not null]
  "status" text [not null, note: '''CHECK ((status = ANY (ARRAY['Prepared'::text, 'Started'::text])))''']
  "created_at" timestamptz [not null]
  "expires_at" timestamptz [not null]
  "started_at" timestamptz
}

Table trainings {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "release_id" uuid [not null]
  "scenario_version_id" uuid [not null]
  "organization_id" uuid [not null]
  "name" text [not null, note: '''CHECK ((btrim(name) <> ''::text))''']
  "description" text
  "start_date" timestamptz
  "end_date" timestamptz
  "status" training_status_enum [not null, default: `'Draft'::training_status_enum`]
  "mode" session_mode_enum [not null, default: `'Guided'::session_mode_enum`]
  "allowed_modes" "text[]" [not null, default: `ARRAY['Learn'::text, 'Guided'::text, 'Assessment'::text]`]
  "max_attempts" integer [note: '''CHECK ((max_attempts > 0))''']
  "created_by" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    (id, release_id, organization_id) [unique]
    (id, release_id, scenario_version_id, organization_id) [unique]
    (release_id) [name: 'trainings_release']
  }

  Note: '''CHECK (((start_date IS NULL) OR (end_date IS NULL) OR (end_date > start_date)))
CHECK (((cardinality(allowed_modes) > 0) AND (array_position(allowed_modes, NULL::text) IS NULL) AND (allowed_modes <@ ARRAY['Learn'::text, 'Guided'::text, 'Assessment'::text]) AND ((mode)::text = ANY (allowed_modes))))'''
}

Table user_devices {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "user_id" uuid [not null]
  "device_uuid" text [not null, note: '''CHECK ((btrim(device_uuid) <> ''::text))''']
  "device_model" text
  "os_version" text
  "app_version" text
  "last_seen_at" timestamptz [not null, default: `now()`]
  "created_at" timestamptz [not null, default: `now()`]
  "fcm_token" text
  "installation_id" uuid
  "notifications_enabled" boolean [not null, default: false]
  "fcm_token_generation" integer [not null, default: 0]
  "revoked_at" timestamptz
  "fcm_token_updated_at" timestamptz

  indexes {
    (id, user_id) [unique]
    (user_id, device_uuid) [unique]
  }

  Note: '''CREATE UNIQUE INDEX device_active_fcm ON user_devices USING btree (fcm_token) WHERE ((fcm_token IS NOT NULL) AND notifications_enabled AND (revoked_at IS NULL))'''
}

Table users {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "organization_id" uuid
  "email" text [not null, unique, note: '''CHECK (((email = lower(btrim(email))) AND (POSITION(('@'::text) IN (email)) > 1)))''']
  "full_name" text
  "role" user_role_enum [not null]
  "is_active" boolean [not null, default: true]
  "last_login_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "deleted_at" timestamptz
  "firebase_uid" varchar(128)
  "password_hash" text
  "dob" date
  "gender" text
  "phone_number" varchar(32)
  "email_verified_at" timestamptz
  "username" varchar(30) [note: '''CHECK (((username IS NULL) OR (((username)::text = lower((username)::text)) AND ((username)::text ~ '^[a-z0-9._-]{3,30}$'::text)))) NOT VALID''']
  "registration_expires_at" timestamptz
  "avatar_storage_key" text
  "profile_revision_no" bigint [not null, default: 1, note: '''CHECK ((profile_revision_no > 0))''']

  Note: '''CHECK (((role <> 'Trainee'::user_role_enum) OR (username IS NOT NULL)))
CHECK (((password_hash IS NOT NULL) OR (firebase_uid IS NOT NULL)))
CHECK ((((role = 'OrganizationUser'::user_role_enum) AND (organization_id IS NOT NULL)) OR ((role = ANY (ARRAY['PlatformAdmin'::user_role_enum, 'Trainee'::user_role_enum])) AND (organization_id IS NULL))))
CHECK ((((role = 'OrganizationUser'::user_role_enum) AND (organization_id IS NOT NULL)) OR ((role = ANY (ARRAY['PlatformAdmin'::user_role_enum, 'Trainee'::user_role_enum])) AND (organization_id IS NULL))))
CREATE UNIQUE INDEX users_email_normalized_key ON users USING btree (lower(btrim(email)))
CREATE UNIQUE INDEX users_firebase_uid_key ON users USING btree (firebase_uid) WHERE (firebase_uid IS NOT NULL)
CREATE UNIQUE INDEX users_phone_normalized_key ON users USING btree (regexp_replace((phone_number)::text, '[^0-9+]'::text, ''::text, 'g'::text)) WHERE (phone_number IS NOT NULL)
CREATE UNIQUE INDEX users_username_lower_key ON users USING btree (lower((username)::text)) WHERE (username IS NOT NULL)'''
}

Table validation_runs {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "revision_id" uuid [not null]
  "job_id" uuid [not null, unique]
  "kind" text [not null]
  "scenario_version_id" uuid
  "candidate_artifact_id" uuid
  "annotation_set_id" uuid
  "outcome" text [not null, note: '''CHECK ((outcome = ANY (ARRAY['Passed'::text, 'Failed'::text])))''']
  "scenario_hash" varchar(64)
  "validator_version" text [not null, note: '''CHECK ((btrim(validator_version) <> ''::text))''']
  "report" jsonb [not null, note: '''CHECK ((jsonb_typeof(report) = 'object'::text))''']
  "created_at" timestamptz [not null, default: `now()`]
  "processing_attempt_id" uuid
  "processing_job_id" uuid [default: `job_id`]
  "artifact_id" uuid [default: `candidate_artifact_id`]
  "scope" text [default: `kind`]
  "status" text [default: `outcome`]
  "summary" jsonb [default: `report`]
  "started_at" timestamptz
  "finished_at" timestamptz

  indexes {
    (revision_id, kind, outcome) [name: 'validation_revision']
  }
}

