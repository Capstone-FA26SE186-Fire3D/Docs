  "id" uuid [pk, default: `gen_random_uuid()`]
  "checkout_id" uuid [not null]
  "quotation_item_id" uuid [not null]
  "entitlement_id" uuid [not null]
  "base_capacity_revision" integer [not null]
  "status" text [not null, note: '''CHECK ((status = ANY (ARRAY['Reserved'::text, 'Consumed'::text, 'Released'::text])))''']
  "created_at" timestamptz [not null, default: `clock_timestamp()`]
  "updated_at" timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (checkout_id, quotation_item_id) [unique]
  }

  Note: '''CREATE UNIQUE INDEX billing_upgrade_reservation_baseline ON billing_upgrade_reservations USING btree (entitlement_id, base_capacity_revision) WHERE (status = ANY (ARRAY['Reserved'::text, 'Consumed'::text]))'''
}

Table bim_facts {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "revision_id" uuid [not null]
  "ifc_global_id" varchar(255) [not null]
  "entity_type" varchar(100) [not null]
  "property_path" text [not null]
  "value" jsonb
  "source_hash" varchar(64) [not null]
  "quality_flags" jsonb [not null, default: `'[]'::jsonb`]
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    (revision_id, ifc_global_id, property_path) [unique]
    (revision_id, ifc_global_id) [name: 'idx_bim_facts_ifc_global_id']
    (revision_id) [name: 'idx_bim_facts_revision']
  }
}

Table building_contacts {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "building_id" uuid [not null]
  "contact_name" text [not null, note: '''CHECK ((btrim(contact_name) <> ''::text))''']
  "contact_role" text
  "phone" text
  "email" text
  "is_primary" boolean [not null, default: false]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Note: '''CREATE UNIQUE INDEX one_primary_contact ON building_contacts USING btree (building_id) WHERE is_primary'''
}

Table building_locations {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "building_id" uuid [not null, unique]
  "address" text
  "city" text
  "district" text
  "latitude" numeric(10,8) [note: '''CHECK (((latitude >= ('-90'::integer)::numeric) AND (latitude <= (90)::numeric)))''']
  "longitude" numeric(11,8) [note: '''CHECK (((longitude >= ('-180'::integer)::numeric) AND (longitude <= (180)::numeric)))''']
  "geojson" jsonb
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
}

Table building_participation_grants {
  "building_id" uuid [not null]
  "trainee_user_id" uuid [not null]
  "access_revision" bigint [not null]
  "granted_at" timestamptz [not null, default: `now()`]

  indexes {
    (building_id, trainee_user_id, access_revision) [pk]
  }
}

Table building_qr_codes {
  "id" uuid [pk]
  "building_id" uuid [not null]
  "organization_id" uuid [not null]
  "token_hash" varchar(64) [not null, unique, note: '''CHECK (((token_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "label" varchar(255)
  "status" text [not null, note: '''CHECK ((status = ANY (ARRAY['Active'::text, 'Revoked'::text])))''']
  "created_by" uuid [not null]
  "created_at" timestamptz [not null]
  "revoked_at" timestamptz
  "replaced_by" uuid

  Note: '''CHECK (((status = 'Revoked'::text) = (revoked_at IS NOT NULL)))
CREATE INDEX building_qr_codes_building ON building_qr_codes USING btree (building_id, created_at DESC)
CREATE UNIQUE INDEX building_qr_codes_one_active ON building_qr_codes USING btree (building_id) WHERE (status = 'Active'::text)'''
}

Table buildings {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "organization_id" uuid [not null]
  "name" text [not null, note: '''CHECK ((btrim(name) <> ''::text))''']
  "building_type" text
  "total_floors" integer [not null, default: 1, note: '''CHECK ((total_floors > 0))''']
  "is_active" boolean [not null, default: true]
  "created_by" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "deleted_at" timestamptz
  "visibility" text [not null, default: 'Private', note: '''CHECK ((visibility = ANY (ARRAY['Private'::text, 'Public'::text])))''']
  "access_revision" bigint [not null, default: 1, note: '''CHECK ((access_revision > 0))''']
  "participation_code_hash" varchar(64) [note: '''CHECK (((participation_code_hash)::text ~ '^[0-9a-f]{64}$'::text))''']

  indexes {
    (id, organization_id) [unique]
  }
}

Table content_command_receipts {
  "actor_id" uuid [not null]
  "operation" text [not null]
  "idempotency_key" varchar(128) [not null]
  "input_hash" varchar(64) [not null, note: '''CHECK (((input_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "result" jsonb [not null]
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    (actor_id, operation, idempotency_key) [pk]
  }
}

Table device_installations {
  "id" uuid [pk]
  "device_uuid" varchar(255) [not null, unique]
  "secret_hash" varchar(64) [not null, note: '''CHECK (((secret_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "created_at" timestamptz [not null]
  "updated_at" timestamptz [not null]
  "secret_hash_scheme" varchar(32) [note: '''CHECK (((secret_hash_scheme IS NULL) OR ((secret_hash_scheme)::text = ANY (ARRAY[('sha256-text-v1'::character varying)::text, ('sha256-bytes-v2'::character varying)::text]))))''']
}

Table email_verification_jobs {
  "id" uuid [pk]
  "email" text [not null]
  "status" text [not null, default: 'Pending']
  "attempts" integer [not null, default: 0]
  "available_at" timestamptz [not null, default: `now()`]
  "lease_token" uuid
  "lease_until" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "user_id" uuid
  "generation" integer [not null, default: 1]

  indexes {
    (status, available_at, created_at) [name: 'ix_email_verification_jobs_claim']
    (user_id, generation, created_at) [name: 'ix_email_verification_jobs_user_generation']
  }
}

Table email_verification_tokens {
  "id" uuid [pk]
  "user_id" uuid [not null]
  "token_hash" char(64) [not null, unique]
  "created_at" timestamptz [not null, default: `now()`]
  "expires_at" timestamptz [not null]
  "used_at" timestamptz

  indexes {
    (user_id) [name: 'ix_email_verification_tokens_user_id']
  }
}

Table enterprise_quote_requests {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "organization_id" uuid [not null]
  "requested_by" uuid [not null]
  "requested_building_count" integer [not null, note: '''CHECK ((requested_building_count > 0))''']
  "requested_duration_months" integer [note: '''CHECK (((requested_duration_months IS NULL) OR (requested_duration_months > 0)))''']
  "contact_name" text [not null]
  "contact_email" varchar(255) [not null]
  "contact_phone" varchar(50)
  "notes" text
  "status" varchar(20) [not null, default: 'New', note: '''CHECK (((status)::text = ANY (ARRAY[('New'::character varying)::text, ('Contacted'::character varying)::text, ('Quoted'::character varying)::text, ('Accepted'::character varying)::text, ('Rejected'::character varying)::text, ('Cancelled'::character varying)::text, ('Closed'::character varying)::text])))''']
  "quotation_id" uuid
  "idempotency_key" varchar(255) [not null, unique]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "revision" bigint [not null, default: 1, note: '''CHECK ((revision >= 1))''']
  "assigned_to" uuid
  "closed_at" timestamptz
  "closed_by" uuid
  "close_reason" text

  Note: '''CHECK (((((status)::text = 'Closed'::text) = ((closed_at IS NOT NULL) AND (closed_by IS NOT NULL) AND (close_reason IS NOT NULL))) AND ((close_reason IS NULL) OR ((length(btrim(close_reason)) >= 1) AND (length(btrim(close_reason)) <= 1000)))))'''
}

Table enterprise_quote_responses {
  "id" uuid [pk]
  "request_id" uuid [not null]
  "author_id" uuid [not null]
  "message" text [not null, note: '''CHECK (((length(btrim(message)) >= 1) AND (length(btrim(message)) <= 10000)))''']
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    (request_id, created_at, id) [name: 'enterprise_quote_responses_page']
  }
}

Table feedback {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "submitted_by" uuid [not null]
  "organization_id" uuid
  "session_id" uuid
  "category" varchar(100) [not null]
  "rating" integer [note: '''CHECK (((rating IS NULL) OR ((rating >= 1) AND (rating <= 5))))''']
  "message" text [not null, note: '''CHECK ((NULLIF(btrim(message), ''::text) IS NOT NULL))''']
  "status" feedback_status_enum [not null, default: `'Submitted'::feedback_status_enum`]
  "reviewed_by" uuid
  "reviewed_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "revision" bigint [not null, default: 1, note: '''CHECK ((revision > 0))''']

  indexes {
    (organization_id) [name: 'idx_feedback_organization']
    (reviewed_by) [name: 'idx_feedback_reviewed_by']
    (session_id) [name: 'idx_feedback_session']
    (submitted_by) [name: 'idx_feedback_submitted_by']
  }

  Note: '''CHECK (((length(btrim((category)::text)) >= 1) AND (length(btrim((category)::text)) <= 100) AND ((length(btrim(message)) >= 1) AND (length(btrim(message)) <= 10000)) AND ((rating IS NULL) OR ((rating >= 1) AND (rating <= 5)))))
CREATE INDEX feedback_owner_page ON feedback USING btree (submitted_by, created_at DESC, id)'''
}

Table ifc_object_cleanup {
  "object_key" text [pk]
  "available_at" timestamptz [not null]
  "lease_token" uuid
  "lease_until" timestamptz
  "attempts" integer [not null, default: 0]
  "cleaned_at" timestamptz
  "last_error" text

  indexes {
    (available_at, lease_until) [name: 'ifc_cleanup_due']
  }
}

Table ifc_upload_attempts {
  "id" uuid [pk]
  "revision_id" uuid [not null]
  "final_key" text [not null, unique]
  "source_etag" text [not null]
  "input_hash" varchar(64) [not null, note: '''CHECK (((input_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "lease_until" timestamptz [not null]
  "state" text [not null, default: 'Candidate', note: '''CHECK ((state = ANY (ARRAY['Candidate'::text, 'Adopted'::text, 'Abandoned'::text])))''']
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    (state, lease_until) [name: 'ifc_candidate_recovery']
  }
}

Table ifc_upload_intents {
  "revision_id" uuid [pk]
  "building_id" uuid [not null]
  "organization_id" uuid [not null]
  "actor_id" uuid [not null]
  "idempotency_key" varchar(128) [not null]
  "input_hash" varchar(64) [not null, note: '''CHECK (((input_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "staging_key" text [not null, unique]
  "size" bigint [not null, note: '''CHECK ((size > 0))''']
  "hash" varchar(64) [not null, note: '''CHECK (((hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "filename" varchar(255) [not null]
  "expires_at" timestamptz [not null]
  "completed_at" timestamptz
  "completion_hash" varchar(64)
  "final_key" text
  "source_document_id" uuid

  indexes {
    (actor_id, idempotency_key) [unique]
  }

  Note: '''CHECK (((completed_at IS NULL) = (source_document_id IS NULL)))'''
}

Table integration_event_consumptions {
  "consumer_name" varchar(120) [not null, note: '''CHECK ((NULLIF(btrim((consumer_name)::text), ''::text) IS NOT NULL))''']
  "event_key" varchar(255) [not null]
  "payload_hash" varchar(64) [not null, note: '''CHECK (((payload_hash)::text ~ '^[0-9a-fA-F]{64}$'::text))''']
  "result_reference" text
  "processed_at" timestamptz [not null, default: `now()`]

  indexes {
    (consumer_name, event_key) [pk]
    (event_key, payload_hash) [name: 'idx_event_consumptions_hash']
  }
}

Table integration_outbox_events {
  "idempotency_key" varchar(255) [pk]
  "aggregate_type" varchar(80) [not null]
  "aggregate_id" uuid [not null]
  "event_type" varchar(100) [not null]
  "schema_version" varchar(50) [not null, note: '''CHECK ((NULLIF(btrim((schema_version)::text), ''::text) IS NOT NULL))''']
  "organization_id" uuid
  "payload" jsonb [not null]
  "payload_hash" varchar(64) [not null]
  "status" varchar(20) [not null, default: 'Pending', note: '''CHECK (((status)::text = ANY (ARRAY[('Pending'::character varying)::text, ('Leased'::character varying)::text, ('Published'::character varying)::text, ('Failed'::character varying)::text])))''']
  "attempts" integer [not null, default: 0, note: '''CHECK ((attempts >= 0))''']
  "available_at" timestamptz [not null, default: `now()`]
  "lease_owner" varchar(255)
  "lease_token" uuid [unique]
  "lease_until" timestamptz
  "published_lease_token" uuid
  "last_error" text
  "created_at" timestamptz [not null, default: `now()`]
  "published_at" timestamptz

  indexes {
    (status, available_at, lease_until) [name: 'idx_outbox_dispatch']
    (organization_id, status, available_at) [name: 'idx_outbox_scope_dispatch']
  }

  Note: '''CHECK (((((status)::text = 'Leased'::text) AND (NULLIF(btrim((lease_owner)::text), ''::text) IS NOT NULL) AND (lease_token IS NOT NULL) AND (lease_until IS NOT NULL)) OR (((status)::text <> 'Leased'::text) AND (lease_owner IS NULL) AND (lease_token IS NULL) AND (lease_until IS NULL))))
CHECK ((((payload_hash)::text ~ '^[0-9a-fA-F]{64}$'::text) AND (lower((payload_hash)::text) = (fet3d_jsonb_payload_hash(payload))::text)))
CHECK (((((status)::text = 'Published'::text) AND (published_at IS NOT NULL) AND (published_lease_token IS NOT NULL)) OR (((status)::text <> 'Published'::text) AND (published_at IS NULL))))
CHECK (((organization_id IS NOT NULL) OR ((aggregate_type)::text = ANY (ARRAY[('System'::character varying)::text, ('Platform'::character varying)::text]))))'''
}

Table knowledge_chunks {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "source_id" uuid [not null]
  "chunk_index" integer [not null]
  "content" text [not null]
  "locator" jsonb [not null, default: `'{}'::jsonb`]
  "embedding" vector
  "metadata" jsonb [not null, default: `'{}'::jsonb`]
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    (source_id, chunk_index) [unique]
    (source_id) [name: 'idx_knowledge_chunks_source']
  }
}

Table knowledge_source_files {
  "id" uuid [pk]
  "created_by" uuid [not null]
  "idempotency_key" varchar(128) [not null, note: '''CHECK (((idempotency_key)::text ~ '^[!-~]{1,128}$'::text))''']
  "input_hash" char(64) [not null, note: '''CHECK ((input_hash ~ '^[0-9a-f]{64}$'::text))''']
  "file_name" varchar(255) [not null, note: '''CHECK (((length(btrim((file_name)::text)) >= 1) AND (length(btrim((file_name)::text)) <= 255)))''']
  "content_type" text [not null, note: '''CHECK ((content_type = ANY (ARRAY['application/pdf'::text, 'text/markdown'::text, 'text/plain'::text, 'text/html'::text])))''']
  "size_bytes" bigint [not null, note: '''CHECK (((size_bytes >= 1) AND (size_bytes <= 20971520)))''']
  "staging_key" text [not null, unique]
  "object_key" text [unique]
  "sha256" char(64) [note: '''CHECK ((sha256 ~ '^[0-9a-f]{64}$'::text))''']
  "source_id" uuid [unique]
  "created_at" timestamptz [not null]
  "expires_at" timestamptz [not null]
  "completed_at" timestamptz

  indexes {
    (created_by, idempotency_key) [unique]
  }

  Note: '''CHECK ((expires_at > created_at))
CHECK ((((completed_at IS NULL) = (object_key IS NULL)) AND ((completed_at IS NULL) = (sha256 IS NULL))))
CHECK (((source_id IS NULL) OR (completed_at IS NOT NULL)))'''
}

Table knowledge_sources {
  "id" uuid [pk]
  "organization_id" uuid
  "visibility" text [not null, note: '''CHECK ((visibility = ANY (ARRAY['Common'::text, 'Organization'::text])))''']
  "title" text [not null, note: '''CHECK ((NULLIF(btrim(title), ''::text) IS NOT NULL))''']
  "source_uri" text
  "version_label" varchar(100) [not null]
  "source_hash" varchar(64) [not null, note: '''CHECK (((source_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "jurisdiction" text
  "effective_from" timestamptz
  "effective_until" timestamptz
  "approval_status" text [not null, note: '''CHECK ((approval_status = ANY (ARRAY['Draft'::text, 'Approved'::text, 'Retired'::text])))''']
  "approved_by" uuid
  "approved_at" timestamptz
  "created_by" uuid [not null]
  "created_at" timestamptz [not null]
  "revision" bigint [not null, default: 1, note: '''CHECK ((revision > 0))''']

  Note: '''CHECK ((((visibility = 'Common'::text) AND (organization_id IS NULL)) OR ((visibility = 'Organization'::text) AND (organization_id IS NOT NULL))))
CHECK (((approval_status = 'Draft'::text) = (approved_at IS NULL)))
CHECK (((effective_until IS NULL) OR (effective_from IS NULL) OR (effective_until > effective_from)))
CREATE UNIQUE INDEX knowledge_sources_identity ON knowledge_sources USING btree (COALESCE(organization_id, '00000000-0000-0000-0000-000000000000'::uuid), visibility, source_hash, version_label)'''
}

Table learn_bookmarks {
  "trainee_user_id" uuid [not null]
  "post_id" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    (trainee_user_id, post_id) [pk]
  }
}

Table learn_media_images {
  "id" uuid [pk]
  "created_by" uuid [not null]
  "idempotency_key" varchar(128) [not null, note: '''CHECK (((idempotency_key)::text ~ '^[!-~]{1,128}$'::text))''']
  "input_hash" char(64) [not null, note: '''CHECK ((input_hash ~ '^[0-9a-f]{64}$'::text))''']
  "file_name" varchar(255) [not null, note: '''CHECK (((length(btrim((file_name)::text)) >= 1) AND (length(btrim((file_name)::text)) <= 255)))''']
  "content_type" text [not null, note: '''CHECK ((content_type = ANY (ARRAY['image/jpeg'::text, 'image/png'::text, 'image/webp'::text])))''']
  "size_bytes" bigint [not null, note: '''CHECK (((size_bytes >= 1) AND (size_bytes <= 5242880)))''']
  "sha256" char(64) [not null, note: '''CHECK ((sha256 ~ '^[0-9a-f]{64}$'::text))''']
  "staging_key" text [not null, unique]
  "object_key" text [unique]
  "width" integer [note: '''CHECK (((width >= 1) AND (width <= 4096)))''']
  "height" integer [note: '''CHECK (((height >= 1) AND (height <= 4096)))''']
  "created_at" timestamptz [not null]
  "expires_at" timestamptz [not null]
  "completed_at" timestamptz

  indexes {
    (created_by, idempotency_key) [unique]
  }

  Note: '''CHECK ((expires_at > created_at))
CHECK ((((completed_at IS NULL) = (object_key IS NULL)) AND ((completed_at IS NULL) = (width IS NULL)) AND ((completed_at IS NULL) = (height IS NULL))))'''
}

Table learn_post_version_situations {
  "post_version_id" uuid [not null]
  "situation_id" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    (post_version_id, situation_id) [pk]
  }
}

Table learn_post_version_sources {
  "post_version_id" uuid [not null]
  "source_id" uuid [not null]
  "source_role" text [not null, default: 'Reference', note: '''CHECK ((source_role = ANY (ARRAY['Primary'::text, 'Reference'::text, 'Transcript'::text])))''']
  "locator" jsonb [not null, default: `'{}'::jsonb`, note: '''CHECK ((jsonb_typeof(locator) = 'object'::text))''']
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    (post_version_id, source_id, source_role) [pk]
  }
}

Table learn_post_versions {
  "id" uuid [pk]
  "post_id" uuid [not null]
  "version_number" integer [not null, note: '''CHECK ((version_number > 0))''']
  "content_schema_version" varchar(50) [not null]
  "content_kind" text [not null, note: '''CHECK ((content_kind = ANY (ARRAY['Article'::text, 'Tip'::text, 'Video'::text])))''']
  "title" varchar(255) [not null, note: '''CHECK ((NULLIF(btrim((title)::text), ''::text) IS NOT NULL))''']
  "summary" text [not null, note: '''CHECK ((NULLIF(btrim(summary), ''::text) IS NOT NULL))''']
  "cover_image_url" text
  "content_blocks" jsonb [not null, note: '''CHECK ((jsonb_typeof(content_blocks) = 'array'::text))''']
  "content_hash" varchar(64) [not null, note: '''CHECK (((content_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "status" text [not null, note: '''CHECK ((status = ANY (ARRAY['Draft'::text, 'Published'::text])))''']
  "created_by" uuid [not null]
  "published_by" uuid
  "published_at" timestamptz
  "revision_no" bigint [not null, default: 1, note: '''CHECK ((revision_no > 0))''']
  "created_at" timestamptz [not null]
  "updated_at" timestamptz [not null]

  indexes {
    (id, post_id) [unique]
    (post_id, version_number) [unique]
  }

  Note: '''CHECK ((((status = 'Draft'::text) AND (published_by IS NULL) AND (published_at IS NULL)) OR ((status = 'Published'::text) AND (published_by IS NOT NULL) AND (published_at IS NOT NULL))))'''
}

Table learn_posts {
  "id" uuid [pk]
  "slug" varchar(180) [not null, unique, note: '''CHECK (((slug)::text ~ '^[a-z0-9]+(-[a-z0-9]+)*$'::text))''']
  "publication_status" text [not null, note: '''CHECK ((publication_status = ANY (ARRAY['Unpublished'::text, 'Published'::text, 'Hidden'::text, 'Deleted'::text])))''']
  "published_version_id" uuid
  "created_by" uuid [not null]
  "revision_no" bigint [not null, default: 1, note: '''CHECK ((revision_no > 0))''']
  "created_at" timestamptz [not null]
  "updated_at" timestamptz [not null]

  Note: '''CHECK (((publication_status <> ALL (ARRAY['Published'::text, 'Hidden'::text])) OR (published_version_id IS NOT NULL)))'''
}

Table learn_situations {
  "id" uuid [pk]
  "slug" varchar(120) [not null, unique, note: '''CHECK (((slug)::text ~ '^[a-z0-9]+(-[a-z0-9]+)*$'::text))''']
  "name" varchar(255) [not null, note: '''CHECK ((NULLIF(btrim((name)::text), ''::text) IS NOT NULL))''']
  "description" text
  "is_active" boolean [not null, default: true]
  "created_by" uuid [not null]
  "created_at" timestamptz [not null]
  "updated_at" timestamptz [not null]
}

Table learner_command_receipts {
  "actor_id" uuid [not null]
  "operation" text [not null]
  "idempotency_key" varchar(128) [not null]
  "input_hash" varchar(64) [not null, note: '''CHECK (((input_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "result" jsonb [not null]
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    (actor_id, operation, idempotency_key) [pk]
  }
}

Table local_password_reset_tokens {
  "id" uuid [pk]
  "user_id" uuid [not null]
  "token_hash" text [not null, unique, note: '''CHECK ((token_hash ~ '^[a-f0-9]{64}$'::text))''']
  "created_at" timestamptz [not null, default: `now()`]
  "expires_at" timestamptz [not null]
  "used_at" timestamptz

  indexes {
    (user_id) [name: 'ix_local_reset_user']
  }

  Note: '''CHECK ((expires_at > created_at))'''
}

Table notification_deliveries {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "notification_id" uuid [not null]
  "channel" varchar(20) [not null, note: '''CHECK (((channel)::text = ANY (ARRAY[('Web'::character varying)::text, ('Email'::character varying)::text, ('Push'::character varying)::text])))''']
  "status" varchar(20) [not null, default: 'Pending', note: '''CHECK (((status)::text = ANY (ARRAY[('Pending'::character varying)::text, ('Sending'::character varying)::text, ('Sent'::character varying)::text, ('Failed'::character varying)::text])))''']
  "attempts" integer [not null, default: 0, note: '''CHECK ((attempts >= 0))''']
  "provider_message_id" text
  "last_error" text
  "sent_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "lease_token" uuid
  "lease_until" timestamptz
  "next_attempt_at" timestamptz [not null, default: `now()`]

  indexes {
    (notification_id, channel) [unique]
  }

  Note: '''CHECK ((((status)::text = 'Sending'::text) = ((lease_token IS NOT NULL) AND (lease_until IS NOT NULL))))
CREATE INDEX notification_deliveries_claim ON notification_deliveries USING btree (next_attempt_at, created_at) WHERE (((channel)::text = ANY (ARRAY[('Email'::character varying)::text, ('Push'::character varying)::text])) AND ((status)::text = ANY (ARRAY[('Pending'::character varying)::text, ('Sending'::character varying)::text])))
CREATE INDEX notification_deliveries_pending ON notification_deliveries USING btree (created_at) WHERE ((status)::text = 'Pending'::text)'''
}

Table organization_library_items {
  "id" uuid [pk]
  "kind" text [not null, note: '''CHECK ((kind = ANY (ARRAY['ScenarioTemplate'::text, 'RubricSample'::text, 'Equipment'::text, 'StylePreset'::text, 'ColorScheme'::text])))''']
  "code" varchar(80) [not null, unique, note: '''CHECK (((code)::text ~ '^[A-Z0-9][A-Z0-9_-]{0,79}$'::text))''']
  "is_active" boolean [not null, default: true]
  "created_by" uuid [not null]
  "created_at" timestamptz [not null]
  "updated_at" timestamptz [not null]
  "revision" bigint [not null, default: 1, note: '''CHECK ((revision > 0))''']
}

Table organization_library_versions {
  "id" uuid [pk]
  "item_id" uuid [not null]
  "version_number" integer [not null, note: '''CHECK ((version_number > 0))''']
  "name" varchar(255) [not null, note: '''CHECK ((NULLIF(btrim((name)::text), ''::text) IS NOT NULL))''']
  "payload" jsonb [not null, note: '''CHECK ((jsonb_typeof(payload) = 'object'::text))''']
  "required_capabilities" jsonb [not null, default: `'[]'::jsonb`, note: '''CHECK ((jsonb_typeof(required_capabilities) = 'array'::text))''']
  "payload_hash" varchar(64) [not null, note: '''CHECK (((payload_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "status" text [not null, note: '''CHECK ((status = ANY (ARRAY['Draft'::text, 'Published'::text])))''']
  "published_by" uuid
  "published_at" timestamptz
  "created_by" uuid [not null]
  "created_at" timestamptz [not null]
  "updated_at" timestamptz [not null]
  "revision" bigint [not null, default: 1, note: '''CHECK ((revision > 0))''']

  indexes {
    (item_id, version_number) [unique]
  }

  Note: '''CHECK (((status = 'Draft'::text) = (published_at IS NULL)))
CHECK (((status = 'Draft'::text) = (published_by IS NULL)))'''
}

Table organization_notifications {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "organization_id" uuid [not null]
  "recipient_user_id" uuid [not null]
  "building_id" uuid [not null]
  "entitlement_id" uuid [not null]
  "notification_type" varchar(50) [not null, note: '''CHECK (((notification_type)::text = 'BuildingServiceExpiring'::text))''']
  "title" text [not null]
  "body" text [not null]
  "reference_ends_at" timestamptz [not null]
  "idempotency_key" varchar(255) [not null, unique]
  "read_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]

  Note: '''CREATE INDEX organization_notifications_recipient ON organization_notifications USING btree (recipient_user_id, created_at DESC, id)'''
}

Table organizations {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "name" text [not null, note: '''CHECK ((btrim(name) <> ''::text))''']
  "slug" text [not null, unique, note: '''CHECK ((slug ~ '^[a-z0-9]+(-[a-z0-9]+)*$'::text))''']
  "is_active" boolean [not null, default: true]
  "metadata" jsonb [not null, default: `'{}'::jsonb`, note: '''CHECK ((jsonb_typeof(metadata) = 'object'::text))''']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "deleted_at" timestamptz
  "address" text
  "phone" varchar(50)
  "registration_owner_user_id" uuid
  "profile_revision_no" bigint [not null, default: 1, note: '''CHECK ((profile_revision_no > 0)); CHECK ((profile_revision_no > 0))''']

  Note: '''CREATE INDEX ix_organizations_registration_owner_user_id ON organizations USING btree (registration_owner_user_id) WHERE (registration_owner_user_id IS NOT NULL)
CREATE UNIQUE INDEX organizations_phone_normalized_key ON organizations USING btree (regexp_replace((phone)::text, '[^0-9+]'::text, ''::text, 'g'::text)) WHERE (phone IS NOT NULL)'''
}

Table password_reset_email_jobs {
  "id" uuid [pk]
  "email" varchar(254) [not null]
  "status" text [not null, default: 'Pending', note: '''CHECK ((status = ANY (ARRAY['Pending'::text, 'Leased'::text, 'Sent'::text, 'Dead'::text])))''']
  "attempts" integer [not null, default: 0, note: '''CHECK (((attempts >= 0) AND (attempts <= 5)))''']
  "available_at" timestamptz [not null, default: `now()`]
  "created_at" timestamptz [not null, default: `now()`]
  "lease_token" uuid
  "lease_until" timestamptz

  indexes {
    (email, created_at) [name: 'ix_reset_email_dedup']
    (status, available_at, lease_until) [name: 'ix_reset_email_dispatch']
  }

  Note: '''CHECK ((((status = 'Leased'::text) AND (lease_token IS NOT NULL) AND (lease_until IS NOT NULL)) OR ((status <> 'Leased'::text) AND (lease_token IS NULL) AND (lease_until IS NULL))))'''
}

Table payment_provisioning_records {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "payment_transaction_id" uuid [not null]
  "quotation_id" uuid [not null]
  "quotation_item_id" uuid [not null]
  "organization_id" uuid [not null]
  "provisioning_key" varchar(255) [not null, unique]
  "status" varchar(30) [not null, default: 'Pending', note: '''CHECK (((status)::text = ANY (ARRAY[('Pending'::character varying)::text, ('Succeeded'::character varying)::text, ('NeedsReconcile'::character varying)::text])))''']
  "attempts" integer [not null, default: 0, note: '''CHECK ((attempts >= 0))''']
  "last_error" text
  "provisioned_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "lease_token" uuid
  "lease_until" timestamptz
  "next_attempt_at" timestamptz [not null, default: `now()`]

  indexes {
    (payment_transaction_id, quotation_item_id) [unique]
    (status, next_attempt_at) [name: 'idx_payos_provisioning_retry']
  }
}

Table payment_transactions {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "payment_request_id" uuid [not null]
  "webhook_event_id" varchar(255) [not null, unique, note: '''CHECK ((NULLIF(btrim((webhook_event_id)::text), ''::text) IS NOT NULL))''']
  "provider_transaction_id" varchar(255) [unique]
  "received_order_code" bigint [not null]
  "received_amount" numeric(14,2) [not null, note: '''CHECK ((received_amount > (0)::numeric))''']
  "received_currency" varchar(3) [not null, note: '''CHECK (((received_currency)::text ~ '^[A-Z]{3}$'::text))''']
  "signature_verified" boolean [not null, default: false]
  "status" payment_transaction_status_enum [not null, default: `'Received'::payment_transaction_status_enum`]
  "raw_payload" jsonb [not null]
  "rejection_reason" text
  "received_at" timestamptz [not null, default: `now()`]
  "signature_verified_at" timestamptz
  "processed_at" timestamptz

  indexes {
    (id, payment_request_id) [unique]
    (payment_request_id) [name: 'idx_payment_transactions_request']
    (status, received_at) [name: 'idx_payment_transactions_status']
  }

  Note: '''CHECK ((((status = 'Received'::payment_transaction_status_enum) AND (NOT signature_verified) AND (signature_verified_at IS NULL) AND (processed_at IS NULL) AND (rejection_reason IS NULL)) OR ((status = 'Verified'::payment_transaction_status_enum) AND signature_verified AND (signature_verified_at IS NOT NULL) AND (processed_at IS NULL) AND (rejection_reason IS NULL)) OR ((status = 'Applied'::payment_transaction_status_enum) AND signature_verified AND (signature_verified_at IS NOT NULL) AND (processed_at IS NOT NULL) AND (rejection_reason IS NULL)) OR ((status = 'Rejected'::payment_transaction_status_enum) AND signature_verified AND (signature_verified_at IS NOT NULL) AND (processed_at IS NOT NULL) AND (NULLIF(btrim(rejection_reason), ''::text) IS NOT NULL))))'''
}

Table payos_payment_requests {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "quotation_id" uuid [not null]
  "organization_id" uuid [not null]
  "requested_by" uuid [not null]
  "order_code" bigint [not null, unique, note: '''CHECK ((order_code > 0))''']
  "expected_amount" numeric(14,2) [not null, note: '''CHECK ((expected_amount > (0)::numeric))''']
  "expected_currency" varchar(3) [not null, default: 'VND', note: '''CHECK (((expected_currency)::text ~ '^[A-Z]{3}$'::text))''']
  "checkout_url" text [not null]
  "return_url" text [not null]
  "cancel_url" text [not null]
  "status" payment_request_status_enum [not null, default: `'Pending'::payment_request_status_enum`]
  "paid_transaction_id" uuid [unique]
  "expires_at" timestamptz
  "paid_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "idempotency_key" varchar(255) [not null, default: `(gen_random_uuid())::text`]
  "payment_link_id" varchar(100)

  indexes {
    (organization_id) [name: 'idx_payos_payment_requests_organization']
    (quotation_id) [name: 'idx_payos_payment_requests_quotation']
    (requested_by) [name: 'idx_payos_payment_requests_requested_by']
    (status, created_at) [name: 'idx_payos_payment_requests_status']
    (idempotency_key) [unique, name: 'ux_payos_idempotency_key']
    (payment_link_id) [unique, name: 'ux_payos_payment_link_id']
  }

  Note: '''CHECK ((((status = 'Paid'::payment_request_status_enum) AND (paid_transaction_id IS NOT NULL) AND (paid_at IS NOT NULL)) OR ((status <> 'Paid'::payment_request_status_enum) AND (paid_transaction_id IS NULL) AND (paid_at IS NULL))))'''
}

Table payos_webhook_inbox {
  "id" uuid [pk]
  "event_key" varchar(255) [not null, unique]
  "input_hash" varchar(64) [not null, note: '''CHECK (((input_hash)::text ~ '^[a-f0-9]{64}$'::text))''']
  "order_code" bigint [not null]
  "payload" jsonb [not null]
  "verified_at" timestamptz [not null]
  "status" varchar(30) [not null, note: '''CHECK (((status)::text = ANY (ARRAY[('Pending'::character varying)::text, ('Applied'::character varying)::text, ('Rejected'::character varying)::text, ('NeedsReconcile'::character varying)::text])))''']
  "attempts" integer [not null, note: '''CHECK ((attempts >= 0))''']
  "lease_token" uuid
  "lease_until" timestamptz
  "next_attempt_at" timestamptz [not null]
  "created_at" timestamptz [not null]
  "last_error" varchar(80)
  "processed_at" timestamptz

  indexes {
    (status, next_attempt_at) [name: 'idx_webhook_inbox_retry']
  }

  Note: '''CHECK (((lease_token IS NULL) = (lease_until IS NULL)))'''
}

Table playtest_command_receipts {
  "actor_id" uuid [not null]
  "operation" text [not null]
  "idempotency_key" varchar(128) [not null]
  "input_hash" varchar(64) [not null, note: '''CHECK (((input_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "result" jsonb [not null]
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    (actor_id, operation, idempotency_key) [pk]
  }
}

Table playtest_events {
  "playtest_id" uuid [not null]
  "event_id" uuid [not null]
  "sequence" bigint [not null, note: '''CHECK ((sequence >= 1))''']
  "schema_version" varchar(32) [not null]
  "event_type" varchar(100) [not null]
  "occurred_at" timestamptz
  "payload" jsonb [not null]
  "payload_hash" varchar(64) [not null, note: '''CHECK (((payload_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "received_at" timestamptz [not null]
  "rejection_code" varchar(64) [note: '''CHECK (((rejection_code)::text = ANY (ARRAY[('EVENT_TYPE_UNSUPPORTED'::character varying)::text, ('EVENT_PAYLOAD_INVALID'::character varying)::text])))''']

  indexes {
    (playtest_id, event_id) [pk]
    (playtest_id, sequence) [unique]
  }
}

Table playtest_handoffs {
  "id" uuid [pk]
  "playtest_id" uuid [not null]
  "code_hash" varchar(64) [not null, unique, note: '''CHECK (((code_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "code_ciphertext" bytea
  "issuing_family" uuid [not null]
  "created_by" uuid [not null]
  "created_at" timestamptz [not null]
  "expires_at" timestamptz [not null]
  "redeemed_at" timestamptz
  "redeemed_family" uuid
  "revoked_at" timestamptz

  Note: '''CHECK ((expires_at = (created_at + '00:05:00'::interval)))
CHECK (((redeemed_at IS NULL) = (redeemed_family IS NULL)))
CREATE INDEX playtest_handoffs_open ON playtest_handoffs USING btree (playtest_id) WHERE ((redeemed_at IS NULL) AND (revoked_at IS NULL))'''
}

Table playtest_package_pins {
  "playtest_id" uuid [pk]
  "artifact_id" uuid [not null]
  "manifest_artifact_id" uuid [not null]
  "validation_run_id" uuid [not null]
  "attempt_id" uuid [not null]
  "prepared_family" uuid [not null]
  "snapshot" jsonb [not null]
  "started_family" uuid
  "grant_issued_at" timestamptz
  "grant_expires_at" timestamptz

  Note: '''CHECK ((((started_family IS NULL) AND (grant_issued_at IS NULL) AND (grant_expires_at IS NULL)) OR ((started_family IS NOT NULL) AND (grant_expires_at = (grant_issued_at + '00:05:00'::interval)))))'''
}

Table playtest_runtime_state {
  "playtest_id" uuid [pk]
  "bound_family" uuid
  "bound_at" timestamptz
  "grant_generation" integer [not null, default: 0, note: '''CHECK ((grant_generation >= 0))''']
  "grant_issued_at" timestamptz
  "grant_expires_at" timestamptz
  "launched_generation" integer
  "launched_at" timestamptz
  "last_heartbeat_at" timestamptz
  "terminal_at" timestamptz
  "terminal_status" text [note: '''CHECK ((terminal_status = ANY (ARRAY['Completed'::text, 'Cancelled'::text])))''']
  "completion_hash" varchar(64)
  "completion" jsonb

  Note: '''CHECK (((grant_generation = 0) = (grant_issued_at IS NULL)))
CHECK (((grant_expires_at IS NULL) OR (grant_expires_at = (grant_issued_at + '00:05:00'::interval))))
CHECK (((terminal_status IS NULL) = (terminal_at IS NULL)))'''
}

Table playtest_sessions {
  "id" uuid [pk]
  "organization_id" uuid [not null]
  "building_id" uuid [not null]
  "revision_id" uuid [not null]
  "scenario_draft_id" uuid
  "scenario_version_id" uuid [not null]
  "service_entitlement_id" uuid
  "created_by" uuid [not null]
  "package_hash" text [not null]
  "protocol_version" text [not null]
  "manifest_schema_version" text [not null]
  "prepare_idempotency_key" text
  "runtime_version" text
  "start_idempotency_key" text
  "status" text [not null]
  "completion_idempotency_key" text
  "created_at" timestamptz [not null, default: `now()`]
  "started_at" timestamptz
  "ended_at" timestamptz

  indexes {
    (building_id) [name: 'IX_playtest_sessions_building_id']
    (created_by) [name: 'IX_playtest_sessions_created_by']
    (organization_id) [name: 'IX_playtest_sessions_organization_id']
    (revision_id) [name: 'IX_playtest_sessions_revision_id']
    (scenario_draft_id) [name: 'IX_playtest_sessions_scenario_draft_id']
    (scenario_version_id) [name: 'IX_playtest_sessions_scenario_version_id']
  }
}

Table processing_candidate_outputs {
  "attempt_id" uuid [not null]
  "artifact_type" text [not null]
  "input_hash" varchar(64) [not null]
  "artifact_id" uuid [not null, unique]
  "output" jsonb [not null]

  indexes {
    (attempt_id, artifact_type) [pk]
  }
}

Table processing_command_receipts {
  "actor_id" uuid [not null]
  "operation" text [not null]
  "idempotency_key" text [not null]
  "input_hash" varchar(64) [not null]
  "job_id" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    (actor_id, operation, idempotency_key) [pk]
  }
}

Table processing_delivery_receipts {
  "event_key" text [pk]
  "payload_hash" varchar(64) [not null]
  "attempt_id" uuid [not null]
  "receipt_id" uuid [not null, unique]
  "created_at" timestamptz [not null, default: `now()`]
}

Table processing_job_attempts {
  "id" uuid [pk]
  "processing_job_id" uuid [not null]
  "attempt_number" integer [not null, note: '''CHECK ((attempt_number > 0))''']
  "input_hash" varchar(64) [not null, note: '''CHECK (((input_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "toolchain_version" varchar(100) [not null]
  "lease_owner" varchar(100) [not null]
  "lease_token" uuid [not null, unique]
  "lease_until" timestamptz [not null]
  "status" text [not null, note: '''CHECK ((status = ANY (ARRAY['Running'::text, 'Succeeded'::text, 'Failed'::text, 'Expired'::text])))''']
  "output_hash" varchar(64) [note: '''CHECK (((output_hash IS NULL) OR ((output_hash)::text ~ '^[0-9a-f]{64}$'::text)))''']
  "created_at" timestamptz [not null, default: `now()`]
  "started_at" timestamptz [not null, default: `now()`]
  "finished_at" timestamptz
  "error_message" text

  indexes {
    (id, processing_job_id) [unique]
    (processing_job_id, attempt_number) [unique]
    (status, lease_until) [name: 'processing_attempt_expiry']
  }
}

Table processing_jobs {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "revision_id" uuid [not null]
  "source_document_id" uuid [not null]
  "kind" text [not null, default: 'Geometry']
  "scenario_version_id" uuid
  "job_key" uuid [not null, unique]
  "status" text [not null, default: 'Queued', note: '''CHECK ((status = ANY (ARRAY['Queued'::text, 'Running'::text, 'Succeeded'::text, 'Failed'::text])))''']
  "input_hash" text [not null, note: '''CHECK ((btrim(input_hash) <> ''::text))''']
  "lease_owner" text
  "heartbeat_at" timestamptz
  "started_at" timestamptz
  "finished_at" timestamptz
  "error_message" text
  "created_at" timestamptz [not null, default: `now()`]
  "current_attempt_id" uuid
  "input_snapshot" jsonb

  indexes {
    (id, revision_id) [unique]
  }

  Note: '''CHECK (((status = ANY (ARRAY['Succeeded'::text, 'Failed'::text])) = (finished_at IS NOT NULL)))
CHECK (((finished_at IS NULL) OR ((started_at IS NOT NULL) AND (finished_at >= started_at))))
CREATE UNIQUE INDEX one_live_revision_job ON processing_jobs USING btree (revision_id) WHERE (status = ANY (ARRAY['Queued'::text, 'Running'::text]))
CREATE UNIQUE INDEX processing_verified_input_key ON processing_jobs USING btree (revision_id, kind, input_hash, COALESCE(scenario_version_id, '00000000-0000-0000-0000-000000000000'::uuid))'''
}

Table processing_stream_deliveries {
  "id" bigint [pk]
  "event_key" text [not null]
  "lease_token" uuid [not null, unique]
  "stream_name" text [not null]
  "stream_id" text [not null, note: '''CHECK ((stream_id ~ '^[0-9]+-[0-9]+$'::text))''']
  "published_at" timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (stream_name, stream_id) [unique]
    (event_key, published_at) [name: 'processing_stream_delivery_event']
  }
}

Table processing_stream_rejections {
  "stream_name" text [not null]
  "stream_id" text [not null]
  "event_key" text
  "code" text [not null]
  "created_at" timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (stream_name, stream_id) [pk]
  }
}

Table processing_stream_retry_receipts {
  "request_key" text [pk, note: '''CHECK (((length(request_key) >= 1) AND (length(request_key) <= 255)))''']
  "job_id" uuid [not null]
  "event_key" text [not null]
  "reason" text [not null, note: '''CHECK (((length(reason) >= 1) AND (length(reason) <= 1000)))''']
  "previous_delivery" jsonb [not null]
  "created_at" timestamptz [not null, default: `clock_timestamp()`]
}

Table processing_stream_state {
  "event_key" text [pk]
  "delivery_failures" integer [not null, default: 0, note: '''CHECK ((delivery_failures >= 0))''']
  "next_delivery_at" timestamptz [not null, default: `clock_timestamp()`]
  "blocked_reason" text
  "last_replay_at" timestamptz
  "last_error" text
}

Table quotation_building_items {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "quotation_id" uuid [not null]
  "building_id" uuid [not null]
  "service_package_id" uuid [not null]
  "purchase_action" varchar(20) [not null, note: '''CHECK (((purchase_action)::text = ANY (ARRAY[('New'::character varying)::text, ('Renewal'::character varying)::text, ('Upgrade'::character varying)::text])))''']
  "service_duration_months" integer [not null, note: '''CHECK ((service_duration_months > 0))''']
  "unit_price" numeric(14,2) [not null]
  "discount_amount" numeric(14,2) [not null, default: 0]
  "subtotal_amount" numeric(14,2) [not null]
  "total_amount" numeric(14,2) [not null]
  "currency" varchar(3) [not null]
  "price_snapshot" jsonb [not null, default: `'{}'::jsonb`]
  "terms_snapshot" jsonb [not null, default: `'{}'::jsonb`]
  "discount_snapshot" jsonb [not null, default: `'{}'::jsonb`]
  "line_provisioning_key" varchar(255) [unique]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "commercial_version" integer [not null, default: 1]
  "package_revision" bigint
  "learner_limit" integer
  "ai_quota_units" integer
  "ai_policy_version_id" uuid
  "ai_quota_unit" text
  "starts_at" timestamptz
  "ends_at" timestamptz
  "pricing_basis" text [not null, default: 'Monthly']
  "upgrade_entitlement_id" uuid
  "upgrade_base_capacity_revision" integer
  "upgrade_previous_learner_limit" integer

  indexes {
    (id, quotation_id) [unique]
    (quotation_id, building_id) [unique]
    (id, quotation_id) [unique, name: 'ux_billing_line_identity_quote']
  }

  Note: '''CHECK (((unit_price >= (0)::numeric) AND (discount_amount >= (0)::numeric) AND (subtotal_amount >= (0)::numeric) AND (total_amount = (subtotal_amount - discount_amount)) AND (total_amount >= (0)::numeric) AND ((currency)::text ~ '^[A-Z]{3}$'::text)))
CHECK (((((purchase_action)::text = 'Upgrade'::text) = (pricing_basis = 'OneTime'::text)) AND (((purchase_action)::text = 'Upgrade'::text) = (upgrade_entitlement_id IS NOT NULL)) AND (((purchase_action)::text <> 'Upgrade'::text) OR (commercial_version = 7))))
CHECK (((pricing_basis = ANY (ARRAY['Monthly'::text, 'OneTime'::text])) AND ((upgrade_base_capacity_revision IS NULL) OR (upgrade_base_capacity_revision >= 0)) AND ((upgrade_previous_learner_limit IS NULL) OR (upgrade_previous_learner_limit > 0))))
CHECK (((commercial_version = ANY (ARRAY[1, 7])) AND ((commercial_version <> 7) OR ((service_duration_months = ANY (ARRAY[6, 12])) AND (package_revision > 0) AND (package_revision IS NOT NULL) AND (learner_limit > 0) AND (learner_limit IS NOT NULL) AND (ai_quota_units >= 0) AND (ai_quota_units IS NOT NULL) AND ((ai_quota_units = 0) OR ((ai_policy_version_id IS NOT NULL) AND (ai_quota_unit IS NOT NULL))) AND (((starts_at IS NULL) AND (ends_at IS NULL)) OR ((starts_at IS NOT NULL) AND (ends_at IS NOT NULL) AND (ends_at > starts_at)))))))'''
}

Table quotation_topup_items {
  "id" uuid [pk]
  "quotation_id" uuid [not null, unique]
  "organization_id" uuid [not null]
  "requested_quota_units" integer
  "policy_version_id" uuid
  "quota_unit" text
  "quota_units" integer
  "amount" numeric(14,2)
  "starts_at" timestamptz
  "ends_at" timestamptz
  "line_provisioning_key" text [not null, unique]
  "created_at" timestamptz [not null]
  "updated_at" timestamptz [not null]

  Note: '''CHECK ((((requested_quota_units IS NULL) OR (requested_quota_units > 0)) AND ((quota_units IS NULL) OR (quota_units > 0)) AND ((amount IS NULL) OR ((amount >= (0)::numeric) AND (amount = trunc(amount)))) AND ((ends_at IS NULL) OR (starts_at IS NULL) OR (ends_at > starts_at))))'''
}

Table quotations {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "organization_id" uuid [not null]
  "service_package_id" uuid
  "requested_by" uuid [not null]
  "issued_by" uuid
  "quotation_number" varchar(50) [not null, unique]
  "status" quotation_status_enum [not null, default: `'Draft'::quotation_status_enum`]
  "quantity" integer [not null, default: 1, note: '''CHECK ((quantity > 0))''']
  "unit_price" numeric(14,2) [not null]
  "subtotal_amount" numeric(14,2) [not null]
  "tax_amount" numeric(14,2) [not null, default: 0]
  "discount_amount" numeric(14,2) [not null, default: 0]
  "total_amount" numeric(14,2) [not null]
  "currency" varchar(3) [not null, default: 'VND', note: '''CHECK (((currency)::text ~ '^[A-Z]{3}$'::text))''']
  "valid_until" timestamptz [not null]
  "issued_at" timestamptz
  "accepted_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "billing_purpose" varchar(30) [not null, default: 'BuildingService', note: '''CHECK (((billing_purpose)::text = ANY (ARRAY[('BuildingService'::character varying)::text, ('AIUsage'::character varying)::text, ('AIQuotaTopUp'::character varying)::text])))''']
  "discount_rule_id" uuid
  "discount_snapshot" jsonb [not null, default: `'{}'::jsonb`]
  "price_snapshot" jsonb [not null, default: `'{}'::jsonb`]
  "terms_snapshot" jsonb [not null, default: `'{}'::jsonb`]
  "revision" bigint [not null, default: 1]
  "commercial_version" integer [not null, default: 1]

  indexes {
    (issued_by) [name: 'idx_quotations_issued_by']
    (organization_id) [name: 'idx_quotations_organization']
    (requested_by) [name: 'idx_quotations_requested_by']
    (service_package_id) [name: 'idx_quotations_service_package']
  }

  Note: '''CHECK ((((status <> ALL (ARRAY['Draft'::quotation_status_enum, 'Issued'::quotation_status_enum])) OR (accepted_at IS NULL)) AND ((status <> 'Accepted'::quotation_status_enum) OR (accepted_at IS NOT NULL))))
CHECK (((unit_price >= (0)::numeric) AND (subtotal_amount >= (0)::numeric) AND (tax_amount >= (0)::numeric) AND (discount_amount >= (0)::numeric) AND (total_amount = ((subtotal_amount + tax_amount) - discount_amount)) AND (total_amount >= (0)::numeric)))
CHECK (((status = ANY (ARRAY['Draft'::quotation_status_enum, 'Cancelled'::quotation_status_enum])) OR ((issued_by IS NOT NULL) AND (issued_at IS NOT NULL))))'''
}

Table readiness_command_receipts {
  "actor_id" uuid [not null]
  "operation" text [not null]
  "idempotency_key" varchar(128) [not null]
  "input_hash" varchar(64) [not null, note: '''CHECK (((input_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "result" jsonb [not null]
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    (actor_id, operation, idempotency_key) [pk]
  }
}

Table registration_email_challenges {
  "id" uuid [pk]
  "email" text [not null]
  "otp_hash" text [not null]
  "otp_ciphertext" bytea [not null]
  "otp_nonce" bytea [not null]
  "otp_tag" bytea [not null]
  "expires_at" timestamptz [not null]
  "failed_attempts" integer [not null, default: 0, note: '''CHECK (((failed_attempts >= 0) AND (failed_attempts <= 5)))''']
  "verified_at" timestamptz
  "superseded_at" timestamptz
  "registration_token_hash" text
  "registration_token_ciphertext" bytea
  "registration_token_nonce" bytea
  "registration_token_tag" bytea
  "registration_token_expires_at" timestamptz
  "registration_token_used_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Note: '''CHECK ((((verified_at IS NULL) AND (registration_token_hash IS NULL) AND (registration_token_ciphertext IS NULL) AND (registration_token_nonce IS NULL) AND (registration_token_tag IS NULL) AND (registration_token_expires_at IS NULL)) OR ((verified_at IS NOT NULL) AND (registration_token_hash IS NOT NULL) AND (registration_token_ciphertext IS NOT NULL) AND (registration_token_nonce IS NOT NULL) AND (registration_token_tag IS NOT NULL) AND (registration_token_expires_at IS NOT NULL))))
CREATE INDEX ix_registration_email_challenges_active ON registration_email_challenges USING btree (email, created_at DESC) WHERE (superseded_at IS NULL)'''
}

Table registration_otp_email_jobs {
  "id" uuid [pk]
  "challenge_id" uuid [not null]
  "email" text [not null]
  "remote_address" text
  "status" text [not null, default: 'Pending', note: '''CHECK ((status = ANY (ARRAY['Pending'::text, 'Leased'::text, 'Succeeded'::text, 'Dead'::text])))''']
  "attempts" integer [not null, default: 0, note: '''CHECK ((attempts >= 0))''']
  "available_at" timestamptz [not null, default: `now()`]
  "lease_token" uuid
  "lease_until" timestamptz
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    (status, available_at, created_at) [name: 'ix_registration_otp_email_jobs_claim']
  }

  Note: '''CREATE INDEX ix_registration_otp_email_jobs_email_created ON registration_otp_email_jobs USING btree (email, created_at DESC)
CREATE INDEX ix_registration_otp_email_jobs_ip_created ON registration_otp_email_jobs USING btree (remote_address, created_at DESC) WHERE (remote_address IS NOT NULL)'''
}

Table release_build_provenance {
  "release_id" uuid [pk]
  "validation_run_id" uuid [not null]
  "manifest_artifact_id" uuid [not null]
  "attempt_id" uuid [not null]
  "content_review_id" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]
}

Table release_command_receipts {
  "actor_id" uuid [not null]
  "operation" text [not null]
  "idempotency_key" varchar(128) [not null]
  "input_hash" varchar(64) [not null]
  "result" jsonb [not null]

  indexes {
    (actor_id, operation, idempotency_key) [pk]
  }
}

Table release_packages {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "release_id" uuid [not null, unique]
  "candidate_artifact_id" uuid [not null]
  "manifest_url" text [not null, note: '''CHECK ((btrim(manifest_url) <> ''::text))''']
  "manifest_sha256" varchar(64) [not null, note: '''CHECK (((manifest_sha256)::text ~ '^[0-9a-f]{64}$'::text))''']
  "package_url" text [not null, note: '''CHECK ((btrim(package_url) <> ''::text))''']
  "checksum_sha256" varchar(64) [not null, note: '''CHECK (((checksum_sha256)::text ~ '^[0-9a-f]{64}$'::text))''']
  "package_size_bytes" bigint [not null, note: '''CHECK ((package_size_bytes > 0))''']
  "min_runtime_version" text [not null, note: '''CHECK ((btrim(min_runtime_version) <> ''::text))''']
  "schema_version" text [not null, default: '1.0']
  "build_target" text [not null, default: 'Android']
  "created_at" timestamptz [not null, default: `now()`]
}

Table releases {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "revision_id" uuid [not null]
  "scenario_version_id" uuid [not null]
  "building_id" uuid [not null]
  "organization_id" uuid [not null]
  "confirmation_review_id" uuid [not null]
  "published_by" uuid
  "revoked_by" uuid
  "status" release_status_enum [not null, default: `'Built'::release_status_enum`]
  "safety_thresholds" jsonb [not null, default: `'{}'::jsonb`, note: '''CHECK ((jsonb_typeof(safety_thresholds) = 'object'::text))''']
  "revoked_reason" text
  "published_at" timestamptz
  "revoked_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    (id, scenario_version_id, organization_id) [unique]
    (revision_id, scenario_version_id) [unique]
  }

  Note: '''CHECK (((published_at IS NULL) = (published_by IS NULL)))
CHECK (((status <> ALL (ARRAY['Published'::release_status_enum, 'Superseded'::release_status_enum])) OR (published_at IS NOT NULL)))
CHECK (((status <> 'Built'::release_status_enum) OR (published_at IS NULL)))
CHECK ((((status = 'Revoked'::release_status_enum) AND (revoked_by IS NOT NULL) AND (revoked_at IS NOT NULL) AND (NULLIF(btrim(revoked_reason), ''::text) IS NOT NULL)) OR ((status <> 'Revoked'::release_status_enum) AND (revoked_by IS NULL) AND (revoked_at IS NULL) AND (revoked_reason IS NULL))))'''
}

Table revision_artifacts {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "revision_id" uuid [not null]
  "job_id" uuid [not null]
  "artifact_type" text [not null]
  "object_key" text [not null, note: '''CHECK ((btrim(object_key) <> ''::text))''']
  "sha256_hash" varchar(64) [not null, note: '''CHECK (((sha256_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "size_bytes" bigint [not null, note: '''CHECK ((size_bytes > 0))''']
  "schema_version" text [not null, note: '''CHECK ((btrim(schema_version) <> ''::text))''']
  "metadata" jsonb [not null, default: `'{}'::jsonb`, note: '''CHECK ((jsonb_typeof(metadata) = 'object'::text))''']
  "created_at" timestamptz [not null, default: `now()`]
  "attempt_id" uuid
  "is_runtime_ready" boolean [not null, default: false]
  "storage_key" text [default: `object_key`]

  indexes {
    (id, revision_id) [unique]
    (job_id, artifact_type, sha256_hash) [unique]
    (revision_id) [name: 'artifacts_revision']
  }
}

Table revision_equipment_decisions {
  "id" uuid [pk]
  "revision_id" uuid [not null]
  "version_number" integer [not null, note: '''CHECK ((version_number > 0))''']
  "data" jsonb [not null, note: '''CHECK (((jsonb_typeof(data) = 'object'::text) AND (jsonb_typeof((data -> 'items'::text)) = 'array'::text)))''']
  "created_by" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    (revision_id, version_number) [unique]
  }
}

Table revision_issues {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "validation_run_id" uuid [not null]
  "severity" text [not null]
  "code" text [not null]
  "ifc_guid" text
  "message" text [not null, note: '''CHECK ((btrim(message) <> ''::text))''']
  "details" jsonb [not null, default: `'{}'::jsonb`, note: '''CHECK ((jsonb_typeof(details) = 'object'::text))''']
  "created_at" timestamptz [not null, default: `now()`]
}

Table revision_reviews {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "revision_id" uuid [not null]
  "scenario_version_id" uuid [not null]
  "reviewed_by" uuid [not null]
  "validation_run_id" uuid [not null]
  "annotation_set_id" uuid
  "action" review_action_enum [not null]
  "review_message" text
  "reviewed_at" timestamptz [not null, default: `now()`]

  indexes {
    (validation_run_id, action) [unique]
  }

  Note: '''CHECK (((action <> 'Rejected'::review_action_enum) OR (NULLIF(btrim(review_message), ''::text) IS NOT NULL)))
CREATE UNIQUE INDEX one_scenario_confirmation ON revision_reviews USING btree (scenario_version_id) WHERE (action = 'ConfirmForTraining'::review_action_enum)'''
}

Table revision_style_selections {
  "id" uuid [pk]
  "revision_id" uuid [not null]
  "version_number" integer [not null, note: '''CHECK ((version_number > 0))''']
  "data" jsonb [not null, note: '''CHECK ((jsonb_typeof(data) = 'object'::text))''']
  "created_by" uuid [not null]
  "created_at" timestamptz [not null]

  indexes {
    (revision_id, version_number) [unique]
  }
}

Table revisions {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "building_id" uuid [not null]
  "organization_id" uuid [not null]
  "uploaded_by" uuid [not null]
  "version_label" text [not null, note: '''CHECK ((btrim(version_label) <> ''::text))''']
  "primary_type" file_type_enum [not null, default: `'IFC'::file_type_enum`]
  "status" revision_status_enum [not null, default: `'Draft'::revision_status_enum`]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    (building_id, version_label) [unique]
    (id, building_id, organization_id) [unique]
    (id, organization_id) [unique]
  }
}

Table runtime_compatibility_catalog {
  "id" uuid [pk]
  "runtime_version" text [not null]
  "protocol_version" text [not null]
  "manifest_schema_version" text [not null]
  "capabilities" jsonb [not null]
  "is_active" boolean [not null, default: true]
  "created_at" timestamptz [not null, default: `now()`]
  "capability_contracts" jsonb [not null, default: `'{}'::jsonb`, note: '''CHECK ((jsonb_typeof(capability_contracts) = 'object'::text))''']
}

Table scenario_content_reviews {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "scenario_version_id" uuid [not null, unique]
  "status" text [not null, note: '''CHECK ((status = ANY (ARRAY['Submitted'::text, 'Approved'::text, 'Rejected'::text])))''']
  "content_hash" varchar(64) [not null, note: '''CHECK (((content_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "rubric_hash" varchar(64) [not null, note: '''CHECK (((rubric_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "submitted_by" uuid [not null]
  "submitted_at" timestamptz [not null, default: `now()`]
  "reviewed_by" uuid
  "reviewed_at" timestamptz
  "reason" text

  Note: '''CHECK ((((status = 'Submitted'::text) AND (reviewed_by IS NULL) AND (reviewed_at IS NULL)) OR ((status = ANY (ARRAY['Approved'::text, 'Rejected'::text])) AND (reviewed_by IS NOT NULL) AND (reviewed_at IS NOT NULL))))
CHECK (((status <> 'Rejected'::text) OR (NULLIF(btrim(reason), ''::text) IS NOT NULL)))'''
}

Table scenario_drafts {
  "id" uuid [pk]
  "scenario_id" uuid [not null]
