Ref validation_runs_candidate_artifact_id_revision_id_fkey: validation_runs.(candidate_artifact_id, revision_id) > revision_artifacts.(id, revision_id) [delete: no action]
Ref validation_runs_job_id_revision_id_fkey: validation_runs.(job_id, revision_id) > processing_jobs.(id, revision_id) [delete: no action]
Ref validation_runs_processing_attempt_id_fkey: validation_runs.processing_attempt_id > processing_job_attempts.id [delete: no action]
Ref validation_runs_revision_id_fkey: validation_runs.revision_id > revisions.id [delete: no action]
Ref validation_runs_scenario_version_id_fkey: validation_runs.scenario_version_id > scenario_versions.id [delete: no action]

