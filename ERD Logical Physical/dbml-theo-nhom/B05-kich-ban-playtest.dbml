// Fire3D physical model, group B5.
// Paste into https://dbdiagram.io . Gray tables belong to other groups and only show the columns referenced here.

Table scenarios {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "building_id" uuid [not null]
  "organization_id" uuid [not null]
  "name" text [not null, note: '''CHECK ((btrim(name) <> ''::text))''']
  "created_by" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    (id, building_id, organization_id) [unique]
  }
}

Table scenario_drafts {
  "id" uuid [pk]
  "scenario_id" uuid [not null]
  "revision_id" uuid [not null]
  "organization_id" uuid [not null]
  "building_id" uuid [not null]
  "draft_number" integer [not null]
  "state" jsonb [not null]
  "source" text [not null]
  "last_ai_request_id" uuid
  "created_by" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    (building_id) [name: 'IX_scenario_drafts_building_id']
    (created_by) [name: 'IX_scenario_drafts_created_by']
    (organization_id) [name: 'IX_scenario_drafts_organization_id']
    (revision_id) [name: 'IX_scenario_drafts_revision_id']
    (scenario_id) [name: 'IX_scenario_drafts_scenario_id']
    (scenario_id, draft_number) [unique, name: 'scenario_draft_number_key']
  }
}

Table scenario_versions {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "scenario_id" uuid [not null]
  "revision_id" uuid [not null]
  "building_id" uuid [not null]
  "organization_id" uuid [not null]
  "version_number" integer [not null, note: '''CHECK ((version_number > 0))''']
  "name" text [not null, note: '''CHECK ((btrim(name) <> ''::text))''']
  "schema_version" text [not null, default: '1.0']
  "algorithm_version" text [not null, note: '''CHECK ((btrim(algorithm_version) <> ''::text))''']
  "random_seed" bigint [not null]
  "time_limit_seconds" integer [not null]
  "spawn_config" jsonb [not null]
  "goal_config" jsonb [not null]
  "fire_source_config" jsonb [not null, default: `'{}'::jsonb`]
  "npc_config" jsonb [not null, default: `'{}'::jsonb`]
  "blocked_elements" jsonb [not null, default: `'[]'::jsonb`, note: '''CHECK ((jsonb_typeof(blocked_elements) = 'array'::text))''']
  "routing_config" jsonb [not null, note: '''CHECK ((jsonb_typeof(routing_config) = 'object'::text))''']
  "scoring_config" jsonb [not null, note: '''CHECK ((jsonb_typeof(scoring_config) = 'object'::text))''']
  "mode_policy" jsonb [not null]
  "safety_thresholds" jsonb [not null, default: `'{}'::jsonb`, note: '''CHECK ((jsonb_typeof(safety_thresholds) = 'object'::text))''']
  "replan_interval_seconds" integer [not null, default: 5]
  "scenario_hash" varchar(64) [not null, note: '''CHECK (((scenario_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "created_by" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "state_snapshot" jsonb
  "learning_objectives" jsonb
  "learner_instructions" text
  "rubric" jsonb

  indexes {
    (id, revision_id, organization_id) [unique]
    (scenario_id, version_number) [unique]
  }
}

Table scenario_content_reviews {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "scenario_version_id" uuid [not null, unique]
  "status" text [not null, note: '''CHECK ((status = ANY (ARRAY['Submitted'::text, 'Approved'::text, 'Rejected'::text])))''']
  "content_hash" varchar(64) [not null, note: '''CHECK (((content_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "rubric_hash" varchar(64) [not null, note: '''CHECK (((rubric_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "submitted_by" uuid [not null]
  "submitted_at" timestamptz [not null, default: `now()`]
  "reviewed_by" uuid
  "reviewed_at" timestamptz
  "reason" text

  Note: '''CHECK ((((status = 'Submitted'::text) AND (reviewed_by IS NULL) AND (reviewed_at IS NULL)) OR ((status = ANY (ARRAY['Approved'::text, 'Rejected'::text])) AND (reviewed_by IS NOT NULL) AND (reviewed_at IS NOT NULL))))
CHECK (((status <> 'Rejected'::text) OR (NULLIF(btrim(reason), ''::text) IS NOT NULL)))'''
}

Table runtime_compatibility_catalog {
  "id" uuid [pk]
  "runtime_version" text [not null]
  "protocol_version" text [not null]
  "manifest_schema_version" text [not null]
  "capabilities" jsonb [not null]
  "is_active" boolean [not null, default: true]
  "created_at" timestamptz [not null, default: `now()`]
  "capability_contracts" jsonb [not null, default: `'{}'::jsonb`, note: '''CHECK ((jsonb_typeof(capability_contracts) = 'object'::text))''']
}

Table playtest_sessions {
  "id" uuid [pk]
  "organization_id" uuid [not null]
  "building_id" uuid [not null]
  "revision_id" uuid [not null]
  "scenario_draft_id" uuid
  "scenario_version_id" uuid [not null]
  "service_entitlement_id" uuid
  "created_by" uuid [not null]
  "package_hash" text [not null]
  "protocol_version" text [not null]
  "manifest_schema_version" text [not null]
  "prepare_idempotency_key" text
  "runtime_version" text
  "start_idempotency_key" text
  "status" text [not null]
  "completion_idempotency_key" text
  "created_at" timestamptz [not null, default: `now()`]
  "started_at" timestamptz
  "ended_at" timestamptz

  indexes {
    (building_id) [name: 'IX_playtest_sessions_building_id']
    (created_by) [name: 'IX_playtest_sessions_created_by']
    (organization_id) [name: 'IX_playtest_sessions_organization_id']
    (revision_id) [name: 'IX_playtest_sessions_revision_id']
    (scenario_draft_id) [name: 'IX_playtest_sessions_scenario_draft_id']
    (scenario_version_id) [name: 'IX_playtest_sessions_scenario_version_id']
  }
}

Table playtest_handoffs {
  "id" uuid [pk]
  "playtest_id" uuid [not null]
  "code_hash" varchar(64) [not null, unique, note: '''CHECK (((code_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "code_ciphertext" bytea
  "issuing_family" uuid [not null]
  "created_by" uuid [not null]
  "created_at" timestamptz [not null]
  "expires_at" timestamptz [not null]
  "redeemed_at" timestamptz
  "redeemed_family" uuid
  "revoked_at" timestamptz

  Note: '''CHECK ((expires_at = (created_at + '00:05:00'::interval)))
CHECK (((redeemed_at IS NULL) = (redeemed_family IS NULL)))
CREATE INDEX playtest_handoffs_open ON playtest_handoffs USING btree (playtest_id) WHERE ((redeemed_at IS NULL) AND (revoked_at IS NULL))'''
}

Table playtest_package_pins {
  "playtest_id" uuid [pk]
  "artifact_id" uuid [not null]
  "manifest_artifact_id" uuid [not null]
  "validation_run_id" uuid [not null]
  "attempt_id" uuid [not null]
  "prepared_family" uuid [not null]
  "snapshot" jsonb [not null]
  "started_family" uuid
  "grant_issued_at" timestamptz
  "grant_expires_at" timestamptz

  Note: '''CHECK ((((started_family IS NULL) AND (grant_issued_at IS NULL) AND (grant_expires_at IS NULL)) OR ((started_family IS NOT NULL) AND (grant_expires_at = (grant_issued_at + '00:05:00'::interval)))))'''
}

Table playtest_runtime_state {
  "playtest_id" uuid [pk]
  "bound_family" uuid
  "bound_at" timestamptz
  "grant_generation" integer [not null, default: 0, note: '''CHECK ((grant_generation >= 0))''']
  "grant_issued_at" timestamptz
  "grant_expires_at" timestamptz
  "launched_generation" integer
  "launched_at" timestamptz
  "last_heartbeat_at" timestamptz
  "terminal_at" timestamptz
  "terminal_status" text [note: '''CHECK ((terminal_status = ANY (ARRAY['Completed'::text, 'Cancelled'::text])))''']
  "completion_hash" varchar(64)
  "completion" jsonb

  Note: '''CHECK (((grant_generation = 0) = (grant_issued_at IS NULL)))
CHECK (((grant_expires_at IS NULL) OR (grant_expires_at = (grant_issued_at + '00:05:00'::interval))))
CHECK (((terminal_status IS NULL) = (terminal_at IS NULL)))'''
}

Table playtest_events {
  "playtest_id" uuid [not null]
  "event_id" uuid [not null]
  "sequence" bigint [not null, note: '''CHECK ((sequence >= 1))''']
  "schema_version" varchar(32) [not null]
  "event_type" varchar(100) [not null]
  "occurred_at" timestamptz
  "payload" jsonb [not null]
  "payload_hash" varchar(64) [not null, note: '''CHECK (((payload_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "received_at" timestamptz [not null]
  "rejection_code" varchar(64) [note: '''CHECK (((rejection_code)::text = ANY (ARRAY[('EVENT_TYPE_UNSUPPORTED'::character varying)::text, ('EVENT_PAYLOAD_INVALID'::character varying)::text])))''']

  indexes {
    (playtest_id, event_id) [pk]
    (playtest_id, sequence) [unique]
  }
}

Table buildings [headercolor: #9E9E9E, note: 'nhóm B2'] {
  "id" uuid [pk]
  "organization_id" uuid
}

Table organizations [headercolor: #9E9E9E, note: 'nhóm B1'] {
  "id" uuid [pk]
}

Table processing_job_attempts [headercolor: #9E9E9E, note: 'nhóm B3'] {
  "id" uuid [pk]
}

Table revision_artifacts [headercolor: #9E9E9E, note: 'nhóm B3'] {
  "id" uuid [pk]
}

Table revisions [headercolor: #9E9E9E, note: 'nhóm B3'] {
  "id" uuid [pk]
  "building_id" uuid
  "organization_id" uuid
}

Table users [headercolor: #9E9E9E, note: 'nhóm B1'] {
  "id" uuid [pk]
}

Table validation_runs [headercolor: #9E9E9E, note: 'nhóm B3'] {
  "id" uuid [pk]
}

Ref scenarios_building_id_organization_id_fkey: scenarios.(building_id, organization_id) > buildings.(id, organization_id) [delete: no action]
Ref scenarios_created_by_fkey: scenarios.created_by > users.id [delete: no action]
Ref FK_scenario_drafts_buildings_building_id: scenario_drafts.building_id > buildings.id [delete: cascade]
Ref FK_scenario_drafts_organizations_organization_id: scenario_drafts.organization_id > organizations.id [delete: cascade]
Ref FK_scenario_drafts_revisions_revision_id: scenario_drafts.revision_id > revisions.id [delete: cascade]
Ref FK_scenario_drafts_scenarios_scenario_id: scenario_drafts.scenario_id > scenarios.id [delete: cascade]
Ref FK_scenario_drafts_users_created_by: scenario_drafts.created_by > users.id [delete: cascade]
Ref scenario_versions_created_by_fkey: scenario_versions.created_by > users.id [delete: no action]
Ref scenario_versions_revision_id_building_id_organization_id_fkey: scenario_versions.(revision_id, building_id, organization_id) > revisions.(id, building_id, organization_id) [delete: no action]
Ref scenario_versions_scenario_id_building_id_organization_id_fkey: scenario_versions.(scenario_id, building_id, organization_id) > scenarios.(id, building_id, organization_id) [delete: no action]
Ref scenario_content_reviews_reviewed_by_fkey: scenario_content_reviews.reviewed_by > users.id [delete: no action]
Ref scenario_content_reviews_scenario_version_id_fkey: scenario_content_reviews.scenario_version_id > scenario_versions.id [delete: no action]
Ref scenario_content_reviews_submitted_by_fkey: scenario_content_reviews.submitted_by > users.id [delete: no action]
Ref FK_playtest_sessions_buildings_building_id: playtest_sessions.building_id > buildings.id [delete: cascade]
Ref FK_playtest_sessions_organizations_organization_id: playtest_sessions.organization_id > organizations.id [delete: cascade]
Ref FK_playtest_sessions_revisions_revision_id: playtest_sessions.revision_id > revisions.id [delete: cascade]
Ref FK_playtest_sessions_scenario_drafts_scenario_draft_id: playtest_sessions.scenario_draft_id > scenario_drafts.id [delete: no action]
Ref FK_playtest_sessions_scenario_versions_scenario_version_id: playtest_sessions.scenario_version_id > scenario_versions.id [delete: cascade]
Ref FK_playtest_sessions_users_created_by: playtest_sessions.created_by > users.id [delete: cascade]
Ref playtest_handoffs_created_by_fkey: playtest_handoffs.created_by > users.id [delete: no action]
Ref playtest_handoffs_playtest_id_fkey: playtest_handoffs.playtest_id > playtest_sessions.id [delete: no action]
Ref playtest_package_pins_artifact_id_fkey: playtest_package_pins.artifact_id > revision_artifacts.id [delete: no action]
Ref playtest_package_pins_attempt_id_fkey: playtest_package_pins.attempt_id > processing_job_attempts.id [delete: no action]
Ref playtest_package_pins_manifest_artifact_id_fkey: playtest_package_pins.manifest_artifact_id > revision_artifacts.id [delete: no action]
Ref playtest_package_pins_playtest_id_fkey: playtest_package_pins.playtest_id > playtest_sessions.id [delete: no action]
Ref playtest_package_pins_validation_run_id_fkey: playtest_package_pins.validation_run_id > validation_runs.id [delete: no action]
Ref playtest_runtime_state_playtest_id_fkey: playtest_runtime_state.playtest_id > playtest_sessions.id [delete: no action]
Ref playtest_events_playtest_id_fkey: playtest_events.playtest_id > playtest_sessions.id [delete: no action]
