// Fire3D physical model, group B8.
// Paste into https://dbdiagram.io . Gray tables belong to other groups and only show the columns referenced here.

Enum payment_request_status_enum {
  "Pending"
  "Paid"
  "Expired"
  "Cancelled"
  "Failed"
}

Enum payment_transaction_status_enum {
  "Received"
  "Verified"
  "Rejected"
  "Applied"
}

Enum quotation_status_enum {
  "Draft"
  "Issued"
  "Accepted"
  "Expired"
  "Cancelled"
}

Table service_packages {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "code" varchar(50) [not null, unique]
  "name" varchar(255) [not null]
  "description" text
  "unit_price" numeric(14,2) [not null, note: '''CHECK ((unit_price >= (0)::numeric))''']
  "currency" varchar(3) [not null, default: 'VND', note: '''CHECK (((currency)::text ~ '^[A-Z]{3}$'::text))''']
  "duration_months" integer [note: '''CHECK (((duration_months IS NULL) OR (duration_months > 0)))''']
  "features" jsonb [not null, default: `'{}'::jsonb`]
  "is_active" boolean [not null, default: true]
  "created_by" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "revision" bigint [not null, default: 1]
  "commercial_version" integer [not null, default: 1]
  "learner_limit" integer
  "ai_quota_units" integer
  "ai_policy_version_id" uuid

  indexes {
    (created_by) [name: 'idx_service_packages_created_by']
  }

  Note: '''CHECK (((commercial_version = ANY (ARRAY[1, 7])) AND ((commercial_version <> 7) OR ((duration_months = ANY (ARRAY[6, 12])) AND (learner_limit IS NOT NULL) AND (learner_limit > 0) AND (ai_quota_units IS NOT NULL) AND (ai_quota_units >= 0) AND ((ai_quota_units = 0) OR (ai_policy_version_id IS NOT NULL))))))
CREATE INDEX idx_service_packages_active ON service_packages USING btree (code) WHERE is_active'''
}

Table service_package_discount_rules {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "service_package_id" uuid
  "code" varchar(80) [not null, unique]
  "discount_kind" varchar(20) [not null, note: '''CHECK (((discount_kind)::text = ANY (ARRAY[('Percent'::character varying)::text, ('Fixed'::character varying)::text])))''']
  "discount_value" numeric(14,2) [not null, note: '''CHECK ((discount_value >= (0)::numeric))''']
  "discount_currency" varchar(3)
  "minimum_buildings" integer [not null, default: 1, note: '''CHECK ((minimum_buildings > 0))''']
  "minimum_duration_months" integer [note: '''CHECK (((minimum_duration_months IS NULL) OR (minimum_duration_months > 0)))''']
  "valid_from" timestamptz [not null]
  "valid_until" timestamptz
  "is_active" boolean [not null, default: true]
  "created_by" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "revision" bigint [not null, default: 1]

  Note: '''CHECK (((((discount_kind)::text = 'Fixed'::text) AND (discount_currency IS NOT NULL) AND ((discount_currency)::text ~ '^[A-Z]{3}$'::text)) OR (((discount_kind)::text = 'Percent'::text) AND (discount_currency IS NULL))))
CHECK (((valid_until IS NULL) OR (valid_until > valid_from)))
CHECK ((((discount_kind)::text <> 'Percent'::text) OR (discount_value <= (100)::numeric)))'''
}

Table billing_quota_policy_versions {
  "id" uuid [pk]
  "audience" text [not null]
  "policy_kind" text [not null]
  "quota_unit" text [not null]
  "effective_from" timestamptz [not null]
  "effective_until" timestamptz
  "rollover" text [not null]
  "created_by" uuid [not null]
  "created_at" timestamptz [not null]

  Note: '''CHECK (((audience = 'organization'::text) AND (policy_kind = 'quota'::text) AND (rollover = 'None'::text) AND (quota_unit ~ '^[a-z][a-z0-9_-]{0,49}$'::text) AND ((effective_until IS NULL) OR (effective_until > effective_from))))'''
}

Table quotations {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "organization_id" uuid [not null]
  "service_package_id" uuid
  "requested_by" uuid [not null]
  "issued_by" uuid
  "quotation_number" varchar(50) [not null, unique]
  "status" quotation_status_enum [not null, default: `'Draft'::quotation_status_enum`]
  "quantity" integer [not null, default: 1, note: '''CHECK ((quantity > 0))''']
  "unit_price" numeric(14,2) [not null]
  "subtotal_amount" numeric(14,2) [not null]
  "tax_amount" numeric(14,2) [not null, default: 0]
  "discount_amount" numeric(14,2) [not null, default: 0]
  "total_amount" numeric(14,2) [not null]
  "currency" varchar(3) [not null, default: 'VND', note: '''CHECK (((currency)::text ~ '^[A-Z]{3}$'::text))''']
  "valid_until" timestamptz [not null]
  "issued_at" timestamptz
  "accepted_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "billing_purpose" varchar(30) [not null, default: 'BuildingService', note: '''CHECK (((billing_purpose)::text = ANY (ARRAY[('BuildingService'::character varying)::text, ('AIUsage'::character varying)::text, ('AIQuotaTopUp'::character varying)::text])))''']
  "discount_rule_id" uuid
  "discount_snapshot" jsonb [not null, default: `'{}'::jsonb`]
  "price_snapshot" jsonb [not null, default: `'{}'::jsonb`]
  "terms_snapshot" jsonb [not null, default: `'{}'::jsonb`]
  "revision" bigint [not null, default: 1]
  "commercial_version" integer [not null, default: 1]

  indexes {
    (issued_by) [name: 'idx_quotations_issued_by']
    (organization_id) [name: 'idx_quotations_organization']
    (requested_by) [name: 'idx_quotations_requested_by']
    (service_package_id) [name: 'idx_quotations_service_package']
  }

  Note: '''CHECK ((((status <> ALL (ARRAY['Draft'::quotation_status_enum, 'Issued'::quotation_status_enum])) OR (accepted_at IS NULL)) AND ((status <> 'Accepted'::quotation_status_enum) OR (accepted_at IS NOT NULL))))
CHECK (((unit_price >= (0)::numeric) AND (subtotal_amount >= (0)::numeric) AND (tax_amount >= (0)::numeric) AND (discount_amount >= (0)::numeric) AND (total_amount = ((subtotal_amount + tax_amount) - discount_amount)) AND (total_amount >= (0)::numeric)))
CHECK (((status = ANY (ARRAY['Draft'::quotation_status_enum, 'Cancelled'::quotation_status_enum])) OR ((issued_by IS NOT NULL) AND (issued_at IS NOT NULL))))'''
}

Table quotation_building_items {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "quotation_id" uuid [not null]
  "building_id" uuid [not null]
  "service_package_id" uuid [not null]
  "purchase_action" varchar(20) [not null, note: '''CHECK (((purchase_action)::text = ANY (ARRAY[('New'::character varying)::text, ('Renewal'::character varying)::text, ('Upgrade'::character varying)::text])))''']
  "service_duration_months" integer [not null, note: '''CHECK ((service_duration_months > 0))''']
  "unit_price" numeric(14,2) [not null]
  "discount_amount" numeric(14,2) [not null, default: 0]
  "subtotal_amount" numeric(14,2) [not null]
  "total_amount" numeric(14,2) [not null]
  "currency" varchar(3) [not null]
  "price_snapshot" jsonb [not null, default: `'{}'::jsonb`]
  "terms_snapshot" jsonb [not null, default: `'{}'::jsonb`]
  "discount_snapshot" jsonb [not null, default: `'{}'::jsonb`]
  "line_provisioning_key" varchar(255) [unique]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "commercial_version" integer [not null, default: 1]
  "package_revision" bigint
  "learner_limit" integer
  "ai_quota_units" integer
  "ai_policy_version_id" uuid
  "ai_quota_unit" text
  "starts_at" timestamptz
  "ends_at" timestamptz
  "pricing_basis" text [not null, default: 'Monthly']
  "upgrade_entitlement_id" uuid
  "upgrade_base_capacity_revision" integer
  "upgrade_previous_learner_limit" integer

  indexes {
    (id, quotation_id) [unique]
    (quotation_id, building_id) [unique]
    (id, quotation_id) [unique, name: 'ux_billing_line_identity_quote']
  }

  Note: '''CHECK (((unit_price >= (0)::numeric) AND (discount_amount >= (0)::numeric) AND (subtotal_amount >= (0)::numeric) AND (total_amount = (subtotal_amount - discount_amount)) AND (total_amount >= (0)::numeric) AND ((currency)::text ~ '^[A-Z]{3}$'::text)))
CHECK (((((purchase_action)::text = 'Upgrade'::text) = (pricing_basis = 'OneTime'::text)) AND (((purchase_action)::text = 'Upgrade'::text) = (upgrade_entitlement_id IS NOT NULL)) AND (((purchase_action)::text <> 'Upgrade'::text) OR (commercial_version = 7))))
CHECK (((pricing_basis = ANY (ARRAY['Monthly'::text, 'OneTime'::text])) AND ((upgrade_base_capacity_revision IS NULL) OR (upgrade_base_capacity_revision >= 0)) AND ((upgrade_previous_learner_limit IS NULL) OR (upgrade_previous_learner_limit > 0))))
CHECK (((commercial_version = ANY (ARRAY[1, 7])) AND ((commercial_version <> 7) OR ((service_duration_months = ANY (ARRAY[6, 12])) AND (package_revision > 0) AND (package_revision IS NOT NULL) AND (learner_limit > 0) AND (learner_limit IS NOT NULL) AND (ai_quota_units >= 0) AND (ai_quota_units IS NOT NULL) AND ((ai_quota_units = 0) OR ((ai_policy_version_id IS NOT NULL) AND (ai_quota_unit IS NOT NULL))) AND (((starts_at IS NULL) AND (ends_at IS NULL)) OR ((starts_at IS NOT NULL) AND (ends_at IS NOT NULL) AND (ends_at > starts_at)))))))'''
}

Table quotation_topup_items {
  "id" uuid [pk]
  "quotation_id" uuid [not null, unique]
  "organization_id" uuid [not null]
  "requested_quota_units" integer
  "policy_version_id" uuid
  "quota_unit" text
  "quota_units" integer
  "amount" numeric(14,2)
  "starts_at" timestamptz
  "ends_at" timestamptz
  "line_provisioning_key" text [not null, unique]
  "created_at" timestamptz [not null]
  "updated_at" timestamptz [not null]

  Note: '''CHECK ((((requested_quota_units IS NULL) OR (requested_quota_units > 0)) AND ((quota_units IS NULL) OR (quota_units > 0)) AND ((amount IS NULL) OR ((amount >= (0)::numeric) AND (amount = trunc(amount)))) AND ((ends_at IS NULL) OR (starts_at IS NULL) OR (ends_at > starts_at))))'''
}

Table billing_checkout_operations {
  "id" uuid [pk]
  "quotation_id" uuid [not null]
  "actor_id" uuid [not null]
  "idempotency_key" varchar(128) [not null]
  "input_hash" varchar(64) [not null, note: '''CHECK (((input_hash)::text ~ '^[a-f0-9]{64}$'::text))''']
  "order_code" bigint [not null, unique, note: '''CHECK ((order_code > 0))''']
  "status" varchar(30) [not null, note: '''CHECK (((status)::text = ANY (ARRAY[('Creating'::character varying)::text, ('Ready'::character varying)::text, ('NeedsReconcile'::character varying)::text, ('Failed'::character varying)::text, ('Expired'::character varying)::text, ('Cancelled'::character varying)::text, ('Completed'::character varying)::text])))''']
  "lease_token" uuid
  "lease_until" timestamptz
  "provider_result" jsonb
  "created_at" timestamptz [not null]
  "updated_at" timestamptz [not null]
  "provider_input" jsonb [not null, default: `'{}'::jsonb`]
  "payment_link_id" varchar(100)
  "payment_request_id" uuid
  "expires_at" timestamptz
  "attempts" integer [not null, default: 0]
  "next_attempt_at" timestamptz [not null, default: `now()`]
  "last_error" varchar(80)
  "cancel_requested" boolean [not null, default: false]
  "session_family_id" uuid

  indexes {
    (actor_id, idempotency_key) [unique]
    (status, next_attempt_at) [name: 'idx_payos_checkout_retry']
  }

  Note: '''CHECK (((lease_token IS NULL) = (lease_until IS NULL)))
CREATE UNIQUE INDEX ux_billing_checkout_open_quote ON billing_checkout_operations USING btree (quotation_id) WHERE ((status)::text = ANY (ARRAY[('Creating'::character varying)::text, ('Ready'::character varying)::text, ('NeedsReconcile'::character varying)::text]))'''
}

Table billing_service_reservations {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "checkout_id" uuid [not null]
  "quotation_item_id" uuid [not null]
  "building_id" uuid [not null]
  "organization_id" uuid [not null]
  "starts_at" timestamptz [not null]
  "ends_at" timestamptz [not null]
  "status" text [not null, note: '''CHECK ((status = ANY (ARRAY['Reserved'::text, 'Consumed'::text, 'Released'::text])))''']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    (checkout_id, quotation_item_id) [unique]
  }

  Note: '''billing_service_reservations_building_id_tstzrange_excl: EXCLUDE USING gist (building_id WITH =, tstzrange(starts_at, ends_at, '[)'::text) WITH &&) WHERE ((status = ANY (ARRAY['Reserved'::text, 'Consumed'::text])))
CHECK ((ends_at > starts_at))'''
}

Table billing_upgrade_reservations {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "checkout_id" uuid [not null]
  "quotation_item_id" uuid [not null]
  "entitlement_id" uuid [not null]
  "base_capacity_revision" integer [not null]
  "status" text [not null, note: '''CHECK ((status = ANY (ARRAY['Reserved'::text, 'Consumed'::text, 'Released'::text])))''']
  "created_at" timestamptz [not null, default: `clock_timestamp()`]
  "updated_at" timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (checkout_id, quotation_item_id) [unique]
  }

  Note: '''CREATE UNIQUE INDEX billing_upgrade_reservation_baseline ON billing_upgrade_reservations USING btree (entitlement_id, base_capacity_revision) WHERE (status = ANY (ARRAY['Reserved'::text, 'Consumed'::text]))'''
}

Table payos_payment_requests {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "quotation_id" uuid [not null]
  "organization_id" uuid [not null]
  "requested_by" uuid [not null]
  "order_code" bigint [not null, unique, note: '''CHECK ((order_code > 0))''']
  "expected_amount" numeric(14,2) [not null, note: '''CHECK ((expected_amount > (0)::numeric))''']
  "expected_currency" varchar(3) [not null, default: 'VND', note: '''CHECK (((expected_currency)::text ~ '^[A-Z]{3}$'::text))''']
  "checkout_url" text [not null]
  "return_url" text [not null]
  "cancel_url" text [not null]
  "status" payment_request_status_enum [not null, default: `'Pending'::payment_request_status_enum`]
  "paid_transaction_id" uuid [unique]
  "expires_at" timestamptz
  "paid_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "idempotency_key" varchar(255) [not null, default: `(gen_random_uuid())::text`]
  "payment_link_id" varchar(100)

  indexes {
    (organization_id) [name: 'idx_payos_payment_requests_organization']
    (quotation_id) [name: 'idx_payos_payment_requests_quotation']
    (requested_by) [name: 'idx_payos_payment_requests_requested_by']
    (status, created_at) [name: 'idx_payos_payment_requests_status']
    (idempotency_key) [unique, name: 'ux_payos_idempotency_key']
    (payment_link_id) [unique, name: 'ux_payos_payment_link_id']
  }

  Note: '''CHECK ((((status = 'Paid'::payment_request_status_enum) AND (paid_transaction_id IS NOT NULL) AND (paid_at IS NOT NULL)) OR ((status <> 'Paid'::payment_request_status_enum) AND (paid_transaction_id IS NULL) AND (paid_at IS NULL))))'''
}

Table payos_webhook_inbox {
  "id" uuid [pk]
  "event_key" varchar(255) [not null, unique]
  "input_hash" varchar(64) [not null, note: '''CHECK (((input_hash)::text ~ '^[a-f0-9]{64}$'::text))''']
  "order_code" bigint [not null]
  "payload" jsonb [not null]
  "verified_at" timestamptz [not null]
  "status" varchar(30) [not null, note: '''CHECK (((status)::text = ANY (ARRAY[('Pending'::character varying)::text, ('Applied'::character varying)::text, ('Rejected'::character varying)::text, ('NeedsReconcile'::character varying)::text])))''']
  "attempts" integer [not null, note: '''CHECK ((attempts >= 0))''']
  "lease_token" uuid
  "lease_until" timestamptz
  "next_attempt_at" timestamptz [not null]
  "created_at" timestamptz [not null]
  "last_error" varchar(80)
  "processed_at" timestamptz

  indexes {
    (status, next_attempt_at) [name: 'idx_webhook_inbox_retry']
  }

  Note: '''CHECK (((lease_token IS NULL) = (lease_until IS NULL)))'''
}

Table payment_transactions {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "payment_request_id" uuid [not null]
  "webhook_event_id" varchar(255) [not null, unique, note: '''CHECK ((NULLIF(btrim((webhook_event_id)::text), ''::text) IS NOT NULL))''']
  "provider_transaction_id" varchar(255) [unique]
  "received_order_code" bigint [not null]
  "received_amount" numeric(14,2) [not null, note: '''CHECK ((received_amount > (0)::numeric))''']
  "received_currency" varchar(3) [not null, note: '''CHECK (((received_currency)::text ~ '^[A-Z]{3}$'::text))''']
  "signature_verified" boolean [not null, default: false]
  "status" payment_transaction_status_enum [not null, default: `'Received'::payment_transaction_status_enum`]
  "raw_payload" jsonb [not null]
  "rejection_reason" text
  "received_at" timestamptz [not null, default: `now()`]
  "signature_verified_at" timestamptz
  "processed_at" timestamptz

  indexes {
    (id, payment_request_id) [unique]
    (payment_request_id) [name: 'idx_payment_transactions_request']
    (status, received_at) [name: 'idx_payment_transactions_status']
  }

  Note: '''CHECK ((((status = 'Received'::payment_transaction_status_enum) AND (NOT signature_verified) AND (signature_verified_at IS NULL) AND (processed_at IS NULL) AND (rejection_reason IS NULL)) OR ((status = 'Verified'::payment_transaction_status_enum) AND signature_verified AND (signature_verified_at IS NOT NULL) AND (processed_at IS NULL) AND (rejection_reason IS NULL)) OR ((status = 'Applied'::payment_transaction_status_enum) AND signature_verified AND (signature_verified_at IS NOT NULL) AND (processed_at IS NOT NULL) AND (rejection_reason IS NULL)) OR ((status = 'Rejected'::payment_transaction_status_enum) AND signature_verified AND (signature_verified_at IS NOT NULL) AND (processed_at IS NOT NULL) AND (NULLIF(btrim(rejection_reason), ''::text) IS NOT NULL))))'''
}

Table payment_provisioning_records {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "payment_transaction_id" uuid [not null]
  "quotation_id" uuid [not null]
  "quotation_item_id" uuid [not null]
  "organization_id" uuid [not null]
  "provisioning_key" varchar(255) [not null, unique]
  "status" varchar(30) [not null, default: 'Pending', note: '''CHECK (((status)::text = ANY (ARRAY[('Pending'::character varying)::text, ('Succeeded'::character varying)::text, ('NeedsReconcile'::character varying)::text])))''']
  "attempts" integer [not null, default: 0, note: '''CHECK ((attempts >= 0))''']
  "last_error" text
  "provisioned_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "lease_token" uuid
  "lease_until" timestamptz
  "next_attempt_at" timestamptz [not null, default: `now()`]

  indexes {
    (payment_transaction_id, quotation_item_id) [unique]
    (status, next_attempt_at) [name: 'idx_payos_provisioning_retry']
  }
}

Table service_entitlements {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "organization_id" uuid [not null]
  "building_id" uuid [not null]
  "service_package_id" uuid [not null]
  "quotation_id" uuid
  "quotation_item_id" uuid
  "payment_transaction_id" uuid
  "provisioning_key" varchar(255) [not null, unique]
  "status" varchar(30) [not null, default: 'Active', note: '''CHECK (((status)::text = ANY (ARRAY[('Trial'::character varying)::text, ('Active'::character varying)::text, ('Expired'::character varying)::text, ('Suspended'::character varying)::text, ('Cancelled'::character varying)::text])))''']
  "starts_at" timestamptz [not null]
  "ends_at" timestamptz [not null]
  "price_snapshot" jsonb [not null, default: `'{}'::jsonb`]
  "terms_snapshot" jsonb [not null, default: `'{}'::jsonb`]
  "playtest_units_granted" integer [not null, default: 0]
  "playtest_units_used" integer [not null, default: 0]
  "created_by" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "commercial_version" integer [not null, default: 1]
  "learner_limit" integer

  indexes {
    (building_id, starts_at) [unique]
    (quotation_item_id, payment_transaction_id) [unique]
  }

  Note: '''CHECK ((((status)::text <> 'Active'::text) OR ((quotation_id IS NOT NULL) AND (quotation_item_id IS NOT NULL) AND (payment_transaction_id IS NOT NULL))))
CHECK (((playtest_units_granted >= 0) AND (playtest_units_used >= 0) AND (playtest_units_used <= playtest_units_granted)))
CHECK ((ends_at > starts_at))
CHECK (((commercial_version = ANY (ARRAY[1, 7])) AND ((commercial_version <> 7) OR ((learner_limit IS NOT NULL) AND (learner_limit > 0)))))'''
}

Table billing_entitlement_upgrades {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "entitlement_id" uuid [not null]
  "capacity_revision" integer [not null, note: '''CHECK ((capacity_revision >= 1))''']
  "previous_learner_limit" integer [not null]
  "learner_limit" integer [not null]
  "additional_quota_units" integer [not null, note: '''CHECK ((additional_quota_units >= 0))''']
  "effective_from" timestamptz [not null]
  "quotation_item_id" uuid [not null]
  "payment_transaction_id" uuid [not null]
  "provisioning_key" text [not null, unique]
  "created_at" timestamptz [not null, default: `clock_timestamp()`]

  indexes {
    (entitlement_id, capacity_revision) [unique]
    (quotation_item_id, payment_transaction_id) [unique]
  }

  Note: '''CHECK ((learner_limit > previous_learner_limit))'''
}

Table billing_ai_quota_grants {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "organization_id" uuid [not null]
  "policy_version_id" uuid [not null]
  "quota_unit" text [not null]
  "quota_units" integer [not null, note: '''CHECK ((quota_units > 0))''']
  "starts_at" timestamptz [not null]
  "ends_at" timestamptz [not null]
  "quotation_item_id" uuid
  "payment_transaction_id" uuid [not null]
  "entitlement_id" uuid
  "provisioning_key" text [not null, unique]
  "rollover" text [not null, default: 'None', note: '''CHECK ((rollover = 'None'::text))''']
  "created_at" timestamptz [not null, default: `now()`]
  "source_kind" text [not null, default: 'BuildingService', note: '''CHECK ((source_kind = ANY (ARRAY['BuildingService'::text, 'Upgrade'::text, 'TopUp'::text])))''']
  "upgrade_id" uuid [unique]
  "topup_item_id" uuid

  indexes {
    (quotation_item_id, payment_transaction_id) [unique]
    (topup_item_id, payment_transaction_id) [unique]
  }

  Note: '''CHECK ((ends_at > starts_at))
CHECK ((((source_kind = 'BuildingService'::text) AND (quotation_item_id IS NOT NULL) AND (entitlement_id IS NOT NULL) AND (upgrade_id IS NULL) AND (topup_item_id IS NULL)) OR ((source_kind = 'Upgrade'::text) AND (quotation_item_id IS NOT NULL) AND (entitlement_id IS NOT NULL) AND (upgrade_id IS NOT NULL) AND (topup_item_id IS NULL)) OR ((source_kind = 'TopUp'::text) AND (topup_item_id IS NOT NULL) AND (quotation_item_id IS NULL) AND (entitlement_id IS NULL) AND (upgrade_id IS NULL))))'''
}

Table billing_ai_quota_allocations {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "grant_id" uuid [not null]
  "organization_id" uuid [not null]
  "request_id" uuid [not null]
  "quota_unit" text [not null]
  "reserved_units" integer [not null, note: '''CHECK ((reserved_units > 0))''']
  "consumed_units" integer [note: '''CHECK ((consumed_units >= 0))''']
  "status" text [not null, note: '''CHECK ((status = ANY (ARRAY['Reserved'::text, 'Settled'::text, 'Released'::text])))''']
  "created_at" timestamptz [not null, default: `clock_timestamp()`]
  "settled_at" timestamptz

  indexes {
    (request_id, grant_id) [unique]
    (grant_id, status) [name: 'billing_ai_quota_allocations_grant']
  }

  Note: '''CHECK ((((status = 'Reserved'::text) AND (consumed_units IS NULL) AND (settled_at IS NULL)) OR ((status = 'Settled'::text) AND (consumed_units IS NOT NULL) AND (consumed_units <= reserved_units) AND (settled_at IS NOT NULL)) OR ((status = 'Released'::text) AND (consumed_units IS NULL) AND (settled_at IS NOT NULL))))'''
}

Table enterprise_quote_requests {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "organization_id" uuid [not null]
  "requested_by" uuid [not null]
  "requested_building_count" integer [not null, note: '''CHECK ((requested_building_count > 0))''']
  "requested_duration_months" integer [note: '''CHECK (((requested_duration_months IS NULL) OR (requested_duration_months > 0)))''']
  "contact_name" text [not null]
  "contact_email" varchar(255) [not null]
  "contact_phone" varchar(50)
  "notes" text
  "status" varchar(20) [not null, default: 'New', note: '''CHECK (((status)::text = ANY (ARRAY[('New'::character varying)::text, ('Contacted'::character varying)::text, ('Quoted'::character varying)::text, ('Accepted'::character varying)::text, ('Rejected'::character varying)::text, ('Cancelled'::character varying)::text, ('Closed'::character varying)::text])))''']
  "quotation_id" uuid
  "idempotency_key" varchar(255) [not null, unique]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "revision" bigint [not null, default: 1, note: '''CHECK ((revision >= 1))''']
  "assigned_to" uuid
  "closed_at" timestamptz
  "closed_by" uuid
  "close_reason" text

  Note: '''CHECK (((((status)::text = 'Closed'::text) = ((closed_at IS NOT NULL) AND (closed_by IS NOT NULL) AND (close_reason IS NOT NULL))) AND ((close_reason IS NULL) OR ((length(btrim(close_reason)) >= 1) AND (length(btrim(close_reason)) <= 1000)))))'''
}

Table enterprise_quote_responses {
  "id" uuid [pk]
  "request_id" uuid [not null]
  "author_id" uuid [not null]
  "message" text [not null, note: '''CHECK (((length(btrim(message)) >= 1) AND (length(btrim(message)) <= 10000)))''']
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    (request_id, created_at, id) [name: 'enterprise_quote_responses_page']
  }
}

Table buildings [headercolor: #9E9E9E, note: 'nhóm B2'] {
  "id" uuid [pk]
}

Table organizations [headercolor: #9E9E9E, note: 'nhóm B1'] {
  "id" uuid [pk]
}

Table users [headercolor: #9E9E9E, note: 'nhóm B1'] {
  "id" uuid [pk]
}

