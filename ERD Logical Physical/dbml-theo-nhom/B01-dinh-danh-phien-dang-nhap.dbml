// Fire3D physical model, group B1.
// Paste into https://dbdiagram.io . Gray tables belong to other groups and only show the columns referenced here.

Enum user_role_enum {
  "PlatformAdmin"
  "OrganizationUser"
  "Trainee"
}

Table users {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "organization_id" uuid
  "email" text [not null, unique, note: '''CHECK (((email = lower(btrim(email))) AND (POSITION(('@'::text) IN (email)) > 1)))''']
  "full_name" text
  "role" user_role_enum [not null]
  "is_active" boolean [not null, default: true]
  "last_login_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "deleted_at" timestamptz
  "firebase_uid" varchar(128)
  "password_hash" text
  "dob" date
  "gender" text
  "phone_number" varchar(32)
  "email_verified_at" timestamptz
  "username" varchar(30) [note: '''CHECK (((username IS NULL) OR (((username)::text = lower((username)::text)) AND ((username)::text ~ '^[a-z0-9._-]{3,30}$'::text)))) NOT VALID''']
  "registration_expires_at" timestamptz
  "avatar_storage_key" text
  "profile_revision_no" bigint [not null, default: 1, note: '''CHECK ((profile_revision_no > 0))''']

  Note: '''CHECK (((role <> 'Trainee'::user_role_enum) OR (username IS NOT NULL)))
CHECK (((password_hash IS NOT NULL) OR (firebase_uid IS NOT NULL)))
CHECK ((((role = 'OrganizationUser'::user_role_enum) AND (organization_id IS NOT NULL)) OR ((role = ANY (ARRAY['PlatformAdmin'::user_role_enum, 'Trainee'::user_role_enum])) AND (organization_id IS NULL))))
CHECK ((((role = 'OrganizationUser'::user_role_enum) AND (organization_id IS NOT NULL)) OR ((role = ANY (ARRAY['PlatformAdmin'::user_role_enum, 'Trainee'::user_role_enum])) AND (organization_id IS NULL))))
CREATE UNIQUE INDEX users_email_normalized_key ON users USING btree (lower(btrim(email)))
CREATE UNIQUE INDEX users_firebase_uid_key ON users USING btree (firebase_uid) WHERE (firebase_uid IS NOT NULL)
CREATE UNIQUE INDEX users_phone_normalized_key ON users USING btree (regexp_replace((phone_number)::text, '[^0-9+]'::text, ''::text, 'g'::text)) WHERE (phone_number IS NOT NULL)
CREATE UNIQUE INDEX users_username_lower_key ON users USING btree (lower((username)::text)) WHERE (username IS NOT NULL)'''
}

Table organizations {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "name" text [not null, note: '''CHECK ((btrim(name) <> ''::text))''']
  "slug" text [not null, unique, note: '''CHECK ((slug ~ '^[a-z0-9]+(-[a-z0-9]+)*$'::text))''']
  "is_active" boolean [not null, default: true]
  "metadata" jsonb [not null, default: `'{}'::jsonb`, note: '''CHECK ((jsonb_typeof(metadata) = 'object'::text))''']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "deleted_at" timestamptz
  "address" text
  "phone" varchar(50)
  "registration_owner_user_id" uuid
  "profile_revision_no" bigint [not null, default: 1, note: '''CHECK ((profile_revision_no > 0)); CHECK ((profile_revision_no > 0))''']

  Note: '''CREATE INDEX ix_organizations_registration_owner_user_id ON organizations USING btree (registration_owner_user_id) WHERE (registration_owner_user_id IS NOT NULL)
CREATE UNIQUE INDEX organizations_phone_normalized_key ON organizations USING btree (regexp_replace((phone)::text, '[^0-9+]'::text, ''::text, 'g'::text)) WHERE (phone IS NOT NULL)'''
}

Table auth_refresh_tokens {
  "id" uuid [pk]
  "user_id" uuid [not null]
  "family_id" uuid [not null]
  "token_hash" varchar(64) [not null, unique, note: '''CHECK (((token_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "created_at" timestamptz [not null]
  "expires_at" timestamptz [not null]
  "consumed_at" timestamptz
  "revoked_at" timestamptz

  indexes {
    (expires_at) [name: 'auth_refresh_tokens_expiry']
    (user_id, family_id) [name: 'auth_refresh_tokens_user_family']
  }

  Note: '''CHECK ((expires_at > created_at))
CHECK ((consumed_at >= created_at))
CHECK ((revoked_at >= created_at))
CREATE UNIQUE INDEX auth_refresh_tokens_one_active ON auth_refresh_tokens USING btree (family_id) WHERE ((consumed_at IS NULL) AND (revoked_at IS NULL))'''
}

Table device_installations {
  "id" uuid [pk]
  "device_uuid" varchar(255) [not null, unique]
  "secret_hash" varchar(64) [not null, note: '''CHECK (((secret_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "created_at" timestamptz [not null]
  "updated_at" timestamptz [not null]
  "secret_hash_scheme" varchar(32) [note: '''CHECK (((secret_hash_scheme IS NULL) OR ((secret_hash_scheme)::text = ANY (ARRAY[('sha256-text-v1'::character varying)::text, ('sha256-bytes-v2'::character varying)::text]))))''']
}

Table user_devices {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "user_id" uuid [not null]
  "device_uuid" text [not null, note: '''CHECK ((btrim(device_uuid) <> ''::text))''']
  "device_model" text
  "os_version" text
  "app_version" text
  "last_seen_at" timestamptz [not null, default: `now()`]
  "created_at" timestamptz [not null, default: `now()`]
  "fcm_token" text
  "installation_id" uuid
  "notifications_enabled" boolean [not null, default: false]
  "fcm_token_generation" integer [not null, default: 0]
  "revoked_at" timestamptz
  "fcm_token_updated_at" timestamptz

  indexes {
    (id, user_id) [unique]
    (user_id, device_uuid) [unique]
  }

  Note: '''CREATE UNIQUE INDEX device_active_fcm ON user_devices USING btree (fcm_token) WHERE ((fcm_token IS NOT NULL) AND notifications_enabled AND (revoked_at IS NULL))'''
}

Table auth_google_onboarding_sessions {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "firebase_uid" varchar(128) [not null, note: '''CHECK ((length((firebase_uid)::text) > 0))''']
  "email" varchar(255) [not null, note: '''CHECK (((email)::text = lower(btrim((email)::text))))''']
  "onboarding_token_hash" varchar(128) [not null, unique, note: '''CHECK (((onboarding_token_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "requested_role" user_role_enum [note: '''CHECK (((requested_role IS NULL) OR (requested_role = ANY (ARRAY['Trainee'::user_role_enum, 'OrganizationUser'::user_role_enum]))))''']
  "organization_draft" jsonb [not null, default: `'{}'::jsonb`]
  "expires_at" timestamptz [not null]
  "completed_at" timestamptz
  "completed_user_id" uuid
  "completed_input_hash" varchar(128)
  "created_at" timestamptz [not null, default: `now()`]
  "display_name" varchar(200)

  Note: '''CHECK (((completed_at IS NULL) OR ((completed_at >= created_at) AND (completed_user_id IS NOT NULL) AND ((completed_input_hash)::text ~ '^[0-9a-f]{64}$'::text) AND (completed_input_hash IS NOT NULL))))
CHECK ((expires_at > created_at))
CHECK (((completed_at IS NOT NULL) OR ((completed_user_id IS NULL) AND (completed_input_hash IS NULL))))
CREATE INDEX idx_google_onboarding_active ON auth_google_onboarding_sessions USING btree (firebase_uid, expires_at) WHERE (completed_at IS NULL)
CREATE INDEX idx_google_onboarding_completed_user ON auth_google_onboarding_sessions USING btree (completed_user_id) WHERE (completed_user_id IS NOT NULL)'''
}

Table registration_email_challenges {
  "id" uuid [pk]
  "email" text [not null]
  "otp_hash" text [not null]
  "otp_ciphertext" bytea [not null]
  "otp_nonce" bytea [not null]
  "otp_tag" bytea [not null]
  "expires_at" timestamptz [not null]
  "failed_attempts" integer [not null, default: 0, note: '''CHECK (((failed_attempts >= 0) AND (failed_attempts <= 5)))''']
  "verified_at" timestamptz
  "superseded_at" timestamptz
  "registration_token_hash" text
  "registration_token_ciphertext" bytea
  "registration_token_nonce" bytea
  "registration_token_tag" bytea
  "registration_token_expires_at" timestamptz
  "registration_token_used_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Note: '''CHECK ((((verified_at IS NULL) AND (registration_token_hash IS NULL) AND (registration_token_ciphertext IS NULL) AND (registration_token_nonce IS NULL) AND (registration_token_tag IS NULL) AND (registration_token_expires_at IS NULL)) OR ((verified_at IS NOT NULL) AND (registration_token_hash IS NOT NULL) AND (registration_token_ciphertext IS NOT NULL) AND (registration_token_nonce IS NOT NULL) AND (registration_token_tag IS NOT NULL) AND (registration_token_expires_at IS NOT NULL))))
CREATE INDEX ix_registration_email_challenges_active ON registration_email_challenges USING btree (email, created_at DESC) WHERE (superseded_at IS NULL)'''
}

Table registration_otp_email_jobs {
  "id" uuid [pk]
  "challenge_id" uuid [not null]
  "email" text [not null]
  "remote_address" text
  "status" text [not null, default: 'Pending', note: '''CHECK ((status = ANY (ARRAY['Pending'::text, 'Leased'::text, 'Succeeded'::text, 'Dead'::text])))''']
  "attempts" integer [not null, default: 0, note: '''CHECK ((attempts >= 0))''']
  "available_at" timestamptz [not null, default: `now()`]
  "lease_token" uuid
  "lease_until" timestamptz
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    (status, available_at, created_at) [name: 'ix_registration_otp_email_jobs_claim']
  }

  Note: '''CREATE INDEX ix_registration_otp_email_jobs_email_created ON registration_otp_email_jobs USING btree (email, created_at DESC)
CREATE INDEX ix_registration_otp_email_jobs_ip_created ON registration_otp_email_jobs USING btree (remote_address, created_at DESC) WHERE (remote_address IS NOT NULL)'''
}

Table local_password_reset_tokens {
  "id" uuid [pk]
  "user_id" uuid [not null]
  "token_hash" text [not null, unique, note: '''CHECK ((token_hash ~ '^[a-f0-9]{64}$'::text))''']
  "created_at" timestamptz [not null, default: `now()`]
  "expires_at" timestamptz [not null]
  "used_at" timestamptz

  indexes {
    (user_id) [name: 'ix_local_reset_user']
  }

  Note: '''CHECK ((expires_at > created_at))'''
}

Table password_reset_email_jobs {
  "id" uuid [pk]
  "email" varchar(254) [not null]
  "status" text [not null, default: 'Pending', note: '''CHECK ((status = ANY (ARRAY['Pending'::text, 'Leased'::text, 'Sent'::text, 'Dead'::text])))''']
  "attempts" integer [not null, default: 0, note: '''CHECK (((attempts >= 0) AND (attempts <= 5)))''']
  "available_at" timestamptz [not null, default: `now()`]
  "created_at" timestamptz [not null, default: `now()`]
  "lease_token" uuid
  "lease_until" timestamptz

  indexes {
    (email, created_at) [name: 'ix_reset_email_dedup']
    (status, available_at, lease_until) [name: 'ix_reset_email_dispatch']
  }

  Note: '''CHECK ((((status = 'Leased'::text) AND (lease_token IS NOT NULL) AND (lease_until IS NOT NULL)) OR ((status <> 'Leased'::text) AND (lease_token IS NULL) AND (lease_until IS NULL))))'''
}

Table email_verification_tokens {
  "id" uuid [pk]
  "user_id" uuid [not null]
  "token_hash" char(64) [not null, unique]
  "created_at" timestamptz [not null, default: `now()`]
  "expires_at" timestamptz [not null]
  "used_at" timestamptz

  indexes {
    (user_id) [name: 'ix_email_verification_tokens_user_id']
  }
}

Table email_verification_jobs {
  "id" uuid [pk]
  "email" text [not null]
  "status" text [not null, default: 'Pending']
  "attempts" integer [not null, default: 0]
  "available_at" timestamptz [not null, default: `now()`]
  "lease_token" uuid
  "lease_until" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "user_id" uuid
  "generation" integer [not null, default: 1]

  indexes {
    (status, available_at, created_at) [name: 'ix_email_verification_jobs_claim']
    (user_id, generation, created_at) [name: 'ix_email_verification_jobs_user_generation']
  }
}

Table avatar_upload_intents {
  "id" uuid [pk]
  "user_id" uuid [not null]
  "staging_object_key" text [not null]
  "content_type" text [not null]
  "expected_size_bytes" bigint [not null]
  "expires_at" timestamptz [not null]
  "completed_at" timestamptz
  "created_at" timestamptz [not null]
  "final_object_key" text
  "expected_profile_revision" bigint
  "candidate_attempt_id" uuid
  "candidate_object_key" text
  "candidate_source_etag" text
  "candidate_lease_until" timestamptz

  indexes {
    (user_id, expires_at) [name: 'IX_avatar_upload_intents_user_id_expires_at']
  }

  Note: '''CREATE UNIQUE INDEX ux_avatar_upload_intents_candidate_object_key ON avatar_upload_intents USING btree (candidate_object_key) WHERE (candidate_object_key IS NOT NULL)'''
}

Table avatar_object_cleanups {
  "id" uuid [pk]
  "object_key" text [not null, unique]
  "available_at" timestamptz [not null]
  "lease_token" uuid
  "lease_until" timestamptz
  "attempts" integer [not null, default: 0, note: '''CHECK ((attempts >= 0))''']
  "created_at" timestamptz [not null]

  indexes {
    (available_at, lease_until) [name: 'ix_avatar_object_cleanups_available_lease']
  }
}

Ref users_organization_id_fkey: users.organization_id > organizations.id [delete: restrict]
Ref auth_refresh_tokens_user_id_fkey: auth_refresh_tokens.user_id > users.id [delete: restrict]
Ref user_devices_installation_id_fkey: user_devices.installation_id > device_installations.id [delete: restrict]
Ref user_devices_user_id_fkey: user_devices.user_id > users.id [delete: restrict]
Ref auth_google_onboarding_sessions_completed_user_id_fkey: auth_google_onboarding_sessions.completed_user_id > users.id [delete: restrict]
Ref registration_otp_email_jobs_challenge_id_fkey: registration_otp_email_jobs.challenge_id > registration_email_challenges.id [delete: cascade]
Ref local_password_reset_tokens_user_id_fkey: local_password_reset_tokens.user_id > users.id [delete: cascade]
Ref email_verification_tokens_user_id_fkey: email_verification_tokens.user_id > users.id [delete: cascade]
Ref FK_avatar_upload_intents_users_user_id: avatar_upload_intents.user_id > users.id [delete: cascade]
