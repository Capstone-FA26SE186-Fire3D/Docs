// Fire3D physical model, group B2.
// Paste into https://dbdiagram.io . Gray tables belong to other groups and only show the columns referenced here.

Table buildings {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "organization_id" uuid [not null]
  "name" text [not null, note: '''CHECK ((btrim(name) <> ''::text))''']
  "building_type" text
  "total_floors" integer [not null, default: 1, note: '''CHECK ((total_floors > 0))''']
  "is_active" boolean [not null, default: true]
  "created_by" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "deleted_at" timestamptz
  "visibility" text [not null, default: 'Private', note: '''CHECK ((visibility = ANY (ARRAY['Private'::text, 'Public'::text])))''']
  "access_revision" bigint [not null, default: 1, note: '''CHECK ((access_revision > 0))''']
  "participation_code_hash" varchar(64) [note: '''CHECK (((participation_code_hash)::text ~ '^[0-9a-f]{64}$'::text))''']

  indexes {
    (id, organization_id) [unique]
  }
}

Table building_locations {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "building_id" uuid [not null, unique]
  "address" text
  "city" text
  "district" text
  "latitude" numeric(10,8) [note: '''CHECK (((latitude >= ('-90'::integer)::numeric) AND (latitude <= (90)::numeric)))''']
  "longitude" numeric(11,8) [note: '''CHECK (((longitude >= ('-180'::integer)::numeric) AND (longitude <= (180)::numeric)))''']
  "geojson" jsonb
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
}

Table building_contacts {
  "id" uuid [pk, default: `extensions.gen_random_uuid()`]
  "building_id" uuid [not null]
  "contact_name" text [not null, note: '''CHECK ((btrim(contact_name) <> ''::text))''']
  "contact_role" text
  "phone" text
  "email" text
  "is_primary" boolean [not null, default: false]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Note: '''CREATE UNIQUE INDEX one_primary_contact ON building_contacts USING btree (building_id) WHERE is_primary'''
}

Table building_participation_grants {
  "building_id" uuid [not null]
  "trainee_user_id" uuid [not null]
  "access_revision" bigint [not null]
  "granted_at" timestamptz [not null, default: `now()`]

  indexes {
    (building_id, trainee_user_id, access_revision) [pk]
  }
}

Table building_qr_codes {
  "id" uuid [pk]
  "building_id" uuid [not null]
  "organization_id" uuid [not null]
  "token_hash" varchar(64) [not null, unique, note: '''CHECK (((token_hash)::text ~ '^[0-9a-f]{64}$'::text))''']
  "label" varchar(255)
  "status" text [not null, note: '''CHECK ((status = ANY (ARRAY['Active'::text, 'Revoked'::text])))''']
  "created_by" uuid [not null]
  "created_at" timestamptz [not null]
  "revoked_at" timestamptz
  "replaced_by" uuid

  Note: '''CHECK (((status = 'Revoked'::text) = (revoked_at IS NOT NULL)))
CREATE INDEX building_qr_codes_building ON building_qr_codes USING btree (building_id, created_at DESC)
CREATE UNIQUE INDEX building_qr_codes_one_active ON building_qr_codes USING btree (building_id) WHERE (status = 'Active'::text)'''
}

Table organizations [headercolor: #9E9E9E, note: 'nhóm B1'] {
  "id" uuid [pk]
}

Table users [headercolor: #9E9E9E, note: 'nhóm B1'] {
  "id" uuid [pk]
}

Ref buildings_created_by_fkey: buildings.created_by > users.id [delete: no action]
Ref buildings_organization_id_fkey: buildings.organization_id > organizations.id [delete: no action]
Ref building_locations_building_id_fkey: building_locations.building_id > buildings.id [delete: no action]
Ref building_contacts_building_id_fkey: building_contacts.building_id > buildings.id [delete: no action]
Ref building_participation_grants_building_id_fkey: building_participation_grants.building_id > buildings.id [delete: no action]
Ref building_participation_grants_trainee_user_id_fkey: building_participation_grants.trainee_user_id > users.id [delete: no action]
Ref building_qr_codes_building_id_fkey: building_qr_codes.building_id > buildings.id [delete: no action]
Ref building_qr_codes_created_by_fkey: building_qr_codes.created_by > users.id [delete: no action]
Ref building_qr_codes_organization_id_fkey: building_qr_codes.organization_id > organizations.id [delete: no action]
Ref building_qr_codes_replaced_by_fkey: building_qr_codes.replaced_by > building_qr_codes.id [delete: no action]
